---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { serviceAreas } from '../../data/serviceAreas';
import type { CityData } from '../../data/serviceAreas';

export const prerender = true;

export function getStaticPaths() {
  return serviceAreas.map(city => ({
    params: { city: city.slug },
    props: { city },
  }));
}

const { city } = Astro.props as { city: CityData };

const shopAddress = '7695 Granger Rd, Cleveland, OH 44125';
const shopPhone = '1-855-425-5336';
const shopEmail = 'alldentpdr@gmail.com';

const title = `Door Ding Repair in ${city.name}, OH | All Dent PDR`;
const description = `Door ding and dent removal near ${city.name}, OH — All Dent PDR's shop is only ${city.driveMinutes} minutes away at 7695 Granger Rd, Cleveland, OH 44125. Paintless dent repair, fast turnaround, free estimates. Call ${shopPhone}.`;
const keywords = `door ding repair ${city.name} OH, dent removal ${city.name} OH, paintless dent repair ${city.name}, car door ding repair ${city.name}, ${city.name} dent repair, ${city.zipCodes.join(', ')}, All Dent PDR`;
const canonical = `https://alldentpdr.com/door-ding-repair/${city.slug}`;

const breadcrumbs = [
  { name: 'Home', url: 'https://alldentpdr.com' },
  { name: 'Service Area', url: 'https://alldentpdr.com/service-area' },
  { name: `${city.name} Door Ding Repair`, url: canonical },
];

const faqItems = [
  {
    question: `How much does door ding repair cost near ${city.name}, OH?`,
    answer: `Pricing depends on dent size, location, and panel access. Many small door dings are in the $75–$150 range. We confirm exact pricing after inspecting the vehicle. ${city.name} drivers can stop by our shop at ${shopAddress} — only ${city.driveMinutes} minutes away.`,
  },
  {
    question: `Does All Dent PDR serve ${city.name} for door ding repairs?`,
    answer: `Yes! ${city.name} drivers can reach our shop at ${shopAddress} in about ${city.driveMinutes} minutes. We also serve nearby ${city.nearbyShops.join(', ')} and throughout ${city.county} County.`,
  },
  {
    question: `Can you fix sharp creases on ${city.name} vehicles?`,
    answer: `Many creases can be improved or fully corrected with PDR when paint is intact. We provide a clear recommendation after inspecting the damage — no pressure, no guesswork.`,
  },
  {
    question: `Do I need an appointment for door ding repair from ${city.name}?`,
    answer: `Walk-ins are welcome at our Cleveland shop. You can also call ${shopPhone} to reserve a time. Our shop is only ${city.driveMinutes} minutes from ${city.name} via easy highway access.`,
  },
  {
    question: `Will door ding repair require repainting?`,
    answer: `In most cases, no. If your paint is intact, we use paintless dent repair to reshape the metal from behind the panel — preserving your factory finish and resale value.`,
  },
];

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': ['AutoRepair', 'LocalBusiness'],
  name: `All Dent PDR — Door Ding Repair serving ${city.name}, OH`,
  description: `Expert door ding and dent removal serving ${city.name}, OH from our shop at ${shopAddress}.`,
  url: canonical,
  telephone: shopPhone,
  email: shopEmail,
  image: 'https://alldentpdr.com/images/logo-branded.svg',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '7695 Granger Rd',
    addressLocality: 'Cleveland',
    addressRegion: 'OH',
    postalCode: '44125',
    addressCountry: 'US',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 41.3960,
    longitude: -81.6100,
  },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday'], opens: '08:00', closes: '18:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Saturday'], opens: '09:00', closes: '14:00' },
  ],
  areaServed: [
    city.name,
    ...city.nearbyShops,
    'Cleveland, OH',
  ],
  priceRange: '$$',
  paymentAccepted: 'Cash, Credit Card',
  sameAs: ['https://share.google/7cCa7EhinPDCM8Owu', 'https://www.facebook.com/alldentpdr/'],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '5',
    reviewCount: '47',
    bestRating: '5',
    worstRating: '1',
  },
};
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  canonical={canonical}
  breadcrumbs={breadcrumbs}
  faqItems={faqItems}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  </Fragment>

  <!-- Hero -->
  <section class="hero">
    <div class="container hero-inner">
      <div>
        <span class="hero-pill">
          Serving {city.name}, OH · {city.distanceMiles} mi from shop · {city.driveMinutes} min drive
        </span>
        <h1>Door ding repair near {city.name}, Ohio</h1>
        <p>
          {city.tagline.replace(/hail damage/gi, 'door ding').replace(/hail/gi, 'dent')} All Dent PDR at <strong>{shopAddress}</strong> restores
          door dings and dents with certified paintless dent repair — paint preserved, no filler, free written estimates before any work begins.
        </p>
        <div class="button-row">
          <a class="button primary" href="/contact">Get a Free Estimate</a>
          <a class="button ghost" href={`mailto:alldentpdr@gmail.com?subject=Door Ding Photos — ${city.name}&body=Please attach photos of your vehicle damage.`}>Upload Dent Photos</a>
        </div>
        <p style="margin-top:16px;font-size:0.95rem;opacity:0.85;">
          📍 {shopAddress} &nbsp;|&nbsp; Mon–Fri 8am–6pm · Sat 9am–2pm
        </p>
      </div>
      <div class="hero-card">
        <h3>Why {city.name} drivers choose All Dent PDR</h3>
        <ul>
          <li>Only {city.driveMinutes} minutes from {city.name}</li>
          <li>Certified paintless dent repair technicians</li>
          <li>Factory OEM finish preserved — no repaint</li>
          <li>Walk-ins welcome · Free damage assessments</li>
          <li>Written estimates before any work begins</li>
          <li>Fast turnaround — most repairs completed same day</li>
        </ul>
        <p class="tag">{shopAddress}</p>
        <p>Trusted by {city.county} County drivers, dealerships, and fleet operators.</p>
      </div>
    </div>
  </section>

  <!-- Trust strip -->
  <div class="trust-strip">
    <div class="trust-item"><strong>{city.driveMinutes} min</strong><span>From {city.name}</span></div>
    <div class="trust-item"><strong>1,000+</strong><span>Vehicles Repaired</span></div>
    <div class="trust-item"><strong>5★</strong><span>Customer Rating</span></div>
    <div class="trust-item"><strong>Same Day</strong><span>Repairs Available</span></div>
  </div>

  <!-- Local detail -->
  <section class="section">
    <div class="container">
      <span class="section-label">Serving {city.name}</span>
      <h2>Your local door ding repair shop near {city.name}, OH</h2>
      <p>{city.uniqueNote}</p>
      <p>
        Drivers in {city.name} can reach our shop via a quick {city.driveMinutes}-minute drive to
        <strong>{shopAddress}</strong>. Walk-ins are welcome any day we're open — no appointment needed for a free assessment.
      </p>
      <div class="grid-3" style="margin-top:36px;">
        <article class="card">
          <h3>Paint preserved</h3>
          <p>PDR reshapes the metal from behind the panel so your original factory paint stays fully intact — protecting resale value.</p>
        </article>
        <article class="card">
          <h3>Fast turnaround</h3>
          <p>Most door ding repairs are completed quickly, often within hours depending on access and dent complexity. No long waits.</p>
        </article>
        <article class="card">
          <h3>Premium finish quality</h3>
          <p>We focus on subtle metal finishing and clean final appearance for {city.name} vehicles — not just removing the obvious low spot.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Common repairs -->
  <section class="section alt">
    <div class="container">
      <span class="section-label">Common Repairs</span>
      <h2>Door ding and crease repairs we handle</h2>
      <div class="grid-3">
        <article class="card">
          <h3>Parking lot dings</h3>
          <p>Small to moderate dents caused by door impacts in tight spaces — the most common repair we see from {city.name} drivers.</p>
        </article>
        <article class="card">
          <h3>Body line dents</h3>
          <p>Precision correction for dents crossing subtle contour lines, requiring careful technique to restore factory shape.</p>
        </article>
        <article class="card">
          <h3>Light creases</h3>
          <p>Repair strategy based on depth and metal stretch to maximize final quality — honest assessment up front.</p>
        </article>
        <article class="card">
          <h3>Shopping cart damage</h3>
          <p>Quick fixes for the small, shallow dents left by runaway carts in parking lots around {city.name}.</p>
        </article>
        <article class="card">
          <h3>Minor collision dents</h3>
          <p>PDR solutions for soft-impact damage where paint is undamaged and metal can be accurately reshaped.</p>
        </article>
        <article class="card">
          <h3>Fleet & dealership dents</h3>
          <p>High-volume dent correction for {city.county} County dealerships and commercial fleet operators.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Shop details -->
  <section class="section">
    <div class="container">
      <span class="section-label">Shop Info</span>
      <h2>Visit All Dent PDR — {city.driveMinutes} minutes from {city.name}</h2>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:32px;align-items:start;" class="responsive-two-col">
        <div>
          <p>
            Dropping off your vehicle from {city.name} is quick and easy. Our shop sits along Granger Rd
            in Cleveland with easy access from I-480, I-77, and Rockside Rd.
          </p>
          <p><strong>Address:</strong><br />7695 Granger Rd<br />Cleveland, OH 44125</p>
          <p><strong>Hours:</strong><br />Mon–Fri: 8:00am – 6:00pm<br />Saturday: 9:00am – 2:00pm<br />Sunday: Closed</p>
          <p>
            <strong>Phone:</strong>{' '}
            <a href={`tel:${shopPhone.replace(/-/g,'')}`} style="color:var(--rust);">{shopPhone}</a>
          </p>
          <p>
            <strong>Email:</strong>{' '}
            <a href={`mailto:${shopEmail}`} style="color:var(--rust);">{shopEmail}</a>
          </p>
          <div class="button-row" style="margin-top:20px;">
            <a class="button primary" href="/contact">Get My Quick Quote</a>
            <a class="button ghost" href="https://maps.google.com/?q=7695+Granger+Rd+Cleveland+OH+44125" target="_blank" rel="noopener">Get Directions</a>
          </div>
        </div>
        <div class="card" style="padding:0;overflow:hidden;border-radius:16px;">
          <iframe
            title={`All Dent PDR shop — door ding repair near ${city.name} OH`}
            src="https://maps.google.com/maps?q=7695+Granger+Rd+Cleveland+OH+44125&output=embed"
            width="100%"
            height="300"
            style="border:0;display:block;"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section alt">
    <div class="container">
      <span class="section-label">How It Works</span>
      <h2>Door ding repair process for {city.name} drivers</h2>
      <div class="grid-3">
        <article class="card">
          <h3>1. Drive in or call ahead</h3>
          <p>Walk-ins are welcome at our Cleveland shop — only {city.driveMinutes} minutes from {city.name}. Call {shopPhone} to reserve a time.</p>
        </article>
        <article class="card">
          <h3>2. Free inspection & estimate</h3>
          <p>We inspect every panel under specialized lighting and provide a written estimate with a clear timeline before any work begins.</p>
        </article>
        <article class="card">
          <h3>3. Expert PDR repair</h3>
          <p>Certified technicians work each dent using precision tools — no shortcuts, no filler, just clean paintless restoration.</p>
        </article>
        <article class="card">
          <h3>4. Final quality check</h3>
          <p>Every vehicle passes a final LED-light inspection before we call you. We don't hand back a car we wouldn't be proud of.</p>
        </article>
        <article class="card">
          <h3>5. Fast pickup</h3>
          <p>Most door ding repairs are done the same day. We'll call or text when your {city.name} vehicle is ready for pickup.</p>
        </article>
        <article class="card">
          <h3>6. Factory finish intact</h3>
          <p>Your {city.name} vehicle leaves with original paint preserved — protecting factory warranty and resale value.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Nearby areas -->
  <section class="section">
    <div class="container">
      <span class="section-label">Also Serving</span>
      <h2>Other communities near {city.name} we serve</h2>
      <p>
        Our shop is the go-to door ding repair destination for all of {city.county} County and beyond.
        In addition to {city.name}, we regularly serve:
      </p>
      <div style="display:flex;flex-wrap:wrap;gap:12px;margin:24px 0;">
        {city.nearbyShops.map(n => (
          <a
            href={`/door-ding-repair/${n.toLowerCase().replace(/\s+/g,'-').replace(/[^a-z0-9-]/g,'')}`}
            style="padding:10px 18px;background:var(--card);border-radius:8px;border:1px solid #e8e0d8;font-weight:600;color:var(--rust);text-decoration:none;"
          >
            {n}, OH →
          </a>
        ))}
        <a
          href="/service-area"
          style="padding:10px 18px;background:var(--rust);border-radius:8px;color:#fff;font-weight:600;text-decoration:none;"
        >
          View all 20+ service areas →
        </a>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="section alt">
    <div class="container">
      <span class="section-label">Reviews</span>
      <h2>What Northeast Ohio customers say</h2>
      <div class="grid-3">
        <blockquote class="card">
          <p>"I had a nasty parking lot ding on my driver door. They had it out in a couple hours and you can't tell it was ever there. Paint is perfect."</p>
          <footer style="margin-top:12px;font-style:italic;font-size:0.9rem;color:var(--rust);">— Cuyahoga County driver</footer>
          <div style="color:#f5a623;font-size:1.1rem;letter-spacing:2px;margin-top:6px;">★★★★★</div>
        </blockquote>
        <blockquote class="card">
          <p>"Fast, honest, and the work holds up. I've had body shop work before that looked fine at first and then you notice things. All Dent PDR's finish work is genuinely better."</p>
          <footer style="margin-top:12px;font-style:italic;font-size:0.9rem;color:var(--rust);">— Northeast Ohio vehicle owner</footer>
          <div style="color:#f5a623;font-size:1.1rem;letter-spacing:2px;margin-top:6px;">★★★★★</div>
        </blockquote>
        <blockquote class="card">
          <p>"Dropped it off in the morning and it was done by noon. No paint, no filler, just the dent completely gone. Worth every penny."</p>
          <footer style="margin-top:12px;font-style:italic;font-size:0.9rem;color:var(--rust);">— Bedford area customer</footer>
          <div style="color:#f5a623;font-size:1.1rem;letter-spacing:2px;margin-top:6px;">★★★★★</div>
        </blockquote>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container">
      <span class="section-label">FAQ</span>
      <h2>Questions about door ding repair near {city.name}, OH</h2>
      <div style="display:flex;flex-direction:column;gap:16px;max-width:780px;margin:0 auto;">
        {faqItems.map(item => (
          <details style="background:var(--card);border-radius:12px;padding:20px 24px;border:1px solid #e8e0d8;">
            <summary style="font-weight:600;cursor:pointer;font-size:1.05rem;">{item.question}</summary>
            <p style="margin-top:12px;color:#4a3f35;">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-banner">
    <div class="container">
      <h2>Ready to fix that door ding? Visit us from {city.name} today.</h2>
      <p>
        All Dent PDR · {shopAddress} · Mon–Fri 8am–6pm · Sat 9am–2pm<br />
        Walk-ins welcome · Free estimates · Same-day repairs available
      </p>
      <div class="button-row" style="justify-content:center;">
        <a class="button primary" href="/contact">Get a Free Estimate</a>
        <a class="button ghost" href={`tel:${shopPhone.replace(/-/g,'')}`}>Call {shopPhone}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .responsive-two-col {
    grid-template-columns: 1fr 1fr;
  }
  @media (max-width: 720px) {
    .responsive-two-col {
      grid-template-columns: 1fr;
    }
  }
</style>
