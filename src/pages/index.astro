---
import BaseLayout from '../layouts/BaseLayout.astro';
import BeforeAfter from '../components/BeforeAfter.jsx';

const title = 'Paintless Dent Repair Cleveland & Bedford OH | All Dent PDR';
const description = 'Expert paintless dent repair (PDR) & hail damage repair in Bedford and the greater Cleveland area. Fast, flawless dent removal. Insurance approved. Get a quote today!';
const faqItems = [
	{ question: 'What is paintless dent repair and how does it work?', answer: 'Paintless dent repair (PDR) removes dents from vehicle panels without sanding, fillers, or repainting. A technician uses specialized tools to reshape the metal from behind the panel, preserving your factory paint finish.' },
	{ question: 'How much does paintless dent repair cost in Cleveland?', answer: 'PDR cost depends on dent size, location, and accessibility. Small door dings typically range from $75-$150. Hail damage is quoted per panel after an in-person inspection so we can price the repair accurately for Cleveland and Bedford drivers.' },
	{ question: 'Can auto dent repair near me be fixed without repainting?', answer: 'Yes, if the paint is intact. Most auto dent repair near me searches lead to PDR, which is ideal for door dings, hail dents, and minor collision dents when the factory finish is still good.' },
	{ question: 'Does insurance cover paintless dent repair after hail damage?', answer: 'In most hail damage claims, yes. Comprehensive auto insurance often covers PDR after your deductible. We work directly with insurance carriers and help document the repair for Cleveland-area claims.' },
	{ question: 'Where is the All Dent PDR shop located?', answer: 'Our repair shop is at 7695 Granger Rd, Cleveland, OH 44125, in the south Cleveland area near Garfield Heights and Cuyahoga Heights. We serve Cleveland, Bedford, Parma, Solon, Maple Heights, and nearby suburbs across Northeast Ohio.' }
];
