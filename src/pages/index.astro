---
import BaseLayout from '../layouts/BaseLayout.astro';
import BeforeAfter from '../components/BeforeAfter.jsx';

const title = 'Paintless Dent Repair Cleveland OH | Hail Damage Repair Northeast Ohio | All Dent PDR';
const description = 'All Dent PDR operates a paintless dent repair shop at 7695 Granger Rd, Cleveland, OH 44125, serving the Greater Cleveland area and all of Northeast Ohio. Hail damage repair, door ding removal, and more. Call 1-855-425-5336.';
const faqItems = [
	{ question: 'Where is the All Dent PDR shop located?', answer: 'Our repair shop is at 7695 Granger Rd, Cleveland, OH 44125, in the south Cleveland area near Garfield Heights and Cuyahoga Heights. We serve all of Greater Cleveland, Bedford, Parma, Solon, and Northeast Ohio.' },
  { question: 'What is paintless dent repair?', answer: 'Paintless dent repair (PDR) is a technique that removes dents from vehicle panels without sanding, filling, or repainting. A technician uses specialized tools to reshape the metal from behind the panel, preserving your factory paint finish.' },
  { question: 'How much does paintless dent repair cost near Cleveland, Ohio?', answer: 'PDR cost depends on dent size, location, and accessibility. Small door dings typically range from $75-$150. Hail damage is quoted per panel after an in-person inspection so we can price the repair accurately.' },
  { question: 'How long does a typical PDR repair take?', answer: 'Most single-dent repairs are completed in 1-3 hours. Multi-panel hail damage may take a full day. We provide a timeline upfront so you can plan accordingly.' }
];
---

<BaseLayout title={title} description={description} canonical="https://alldentpdr.com" faqItems={faqItems}>
	<section class="hero">
		<div class="container hero-inner">
			<div>
			<span class="hero-pill">Paintless Dent Repair Shop — Cleveland &amp; Northeast Ohio | 7695 Granger Rd, Cleveland OH 44125</span>
				<h1>Cleveland's trusted paintless dent repair &amp; hail damage shop</h1>
				<p>
					All Dent PDR's repair shop at <strong>7695 Granger Rd, Cleveland, OH 44125</strong> serves the Greater
					Cleveland area and all of Northeast Ohio. We restore hail-damaged vehicles with factory-quality paintless
					dent repair — no repainting, no guesswork, just results your insurance company will approve.
				</p>
				<div class="button-row">
					<a class="button primary" href="/contact">Get a Free Estimate</a>
					<a class="button ghost" href="mailto:alldentpdr@gmail.com?subject=Dent Photo Quote Request&body=Please attach photos of your vehicle damage and include your name and phone number.">Upload Dent Photos</a>
				</div>
			</div>
			<div class="hero-card">
				<h3>We don't just remove dents — we restore your vehicle to factory perfection</h3>
				<ul>
					<li>Local Cleveland shop — established, accountable, and here to stay</li>
					<li>Every panel inspected under LED lighting before we call you</li>
					<li>We won't hand back a car we wouldn't be proud of</li>
					<li>No free gimmicks — honest pricing, real results</li>
					<li>Factory OEM paint preserved on every single repair</li>
					<li>Insurance-approved repairs, handled start to finish</li>
				</ul>
				<p class="tag">Shop: 7695 Granger Rd, Cleveland, OH 44125</p>
				<p>Trusted by Northeast Ohio drivers, dealerships, and insurance partners.</p>
			</div>
		</div>
	</section>

	<div class="trust-strip">
		<div class="trust-item"><strong>1,000+</strong><span>Vehicles Repaired</span></div>
		<div class="trust-item"><strong>Cleveland, OH</strong><span>Local Shop</span></div>
		<div class="trust-item"><strong>100%</strong><span>Paint Preserved</span></div>
		<div class="trust-item"><strong>Detail-First</strong><span>In-Person Evaluations</span></div>
	</div>

	<section class="section">
		<div class="container">
			<span class="section-label">Storm Response</span>
			<h2>Serving Greater Cleveland and all of Northeast Ohio from our south Cleveland shop</h2>
			<p>
				Our shop at <strong>7695 Granger Rd, Cleveland, OH 44125</strong> is conveniently located in south
				Cleveland near Garfield Heights, Cuyahoga Heights, and Newburgh Heights. Drop your vehicle off or
				take advantage of our mobile service for insurance-approved hail damage repair anywhere in Northeast Ohio.
			</p>
			<p>
				We serve Bedford, Parma, Maple Heights, Solon, Warrensville Heights, Twinsburg, Beachwood,
				and dozens of other communities across Cuyahoga and Summit counties.
				<a href="/service-area">See our full service area →</a>
			</p>
			<div class="button-row" style="justify-content: center;">
				<a class="button primary" href="/contact">Get a Free Estimate</a>
				<a class="button ghost" href="/service-area">View Service Area</a>
			</div>
		</div>
	</section>

	<section class="section alt">
		<div class="container">
			<span class="section-label">Our Services</span>
			<h2>Hail damage repair specialists</h2>
			<p>All Dent PDR focuses on one thing — restoring hail-damaged vehicles to factory condition using paintless dent repair. No repainting, no shortcuts.</p>
			<div class="grid-3">
				<article class="card">
					<span class="tag">Assessment</span>
					<h3>Free hail damage inspection</h3>
					<p>Stop by our Cleveland shop or schedule an inspection. We document every panel and give you a clear, itemized repair plan before any work begins.</p>
				</article>
				<article class="card">
					<span class="tag">Hail Damage Repair</span>
					<h3>Panel-by-panel PDR restoration</h3>
					<p>Systematic paintless dent repair across every affected panel — hood, roof, trunk, and doors — preserving your OEM factory finish throughout.</p>
				</article>
				<article class="card">
					<span class="tag">Insurance</span>
					<h3>Direct insurance billing</h3>
					<p>We work directly with your insurance company, handle the paperwork, and ensure the repair scope matches your approved claim.</p>
				</article>
			</div>
		</div>
	</section>

