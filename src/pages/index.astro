---
import BaseLayout from '../layouts/BaseLayout.astro';
import BeforeAfter from '../components/BeforeAfter.jsx';

const title = 'Paintless Dent Repair Cleveland OH | Hail Damage Repair Northeast Ohio | All Dent PDR';
const description = 'All Dent PDR operates a paintless dent repair shop at 7695 Granger Rd, Cleveland, OH 44125, serving the Greater Cleveland area and all of Northeast Ohio. Hail damage repair, door ding removal, and more. Call 1-855-425-5336.';
const faqItems = [
  { question: 'Where is the All Dent PDR shop located?', answer: 'Our repair shop is at 7695 Granger Rd, Cleveland, OH 44125, in the south Cleveland area near Garfield Heights and Cuyahoga Heights. We serve all of Greater Cleveland, Bedford, Parma, Solon, and Northeast Ohio. Mobile service is also available nationwide.' },
  { question: 'What is paintless dent repair?', answer: 'Paintless dent repair (PDR) is a technique that removes dents from vehicle panels without sanding, filling, or repainting. A technician uses specialized tools to reshape the metal from behind the panel, preserving your factory paint finish.' },
  { question: 'How much does paintless dent repair cost near Cleveland, Ohio?', answer: 'PDR cost depends on dent size, location, and accessibility. Small door dings typically range from $75-$150. Hail damage is quoted per panel after an in-person inspection so we can price the repair accurately.' },
  { question: 'How long does a typical PDR repair take?', answer: 'Most single-dent repairs are completed in 1-3 hours. Multi-panel hail damage may take a full day. We provide a timeline upfront so you can plan accordingly.' }
];
---

<BaseLayout title={title} description={description} canonical="https://alldentpdr.com" faqItems={faqItems}>
	<section class="hero">
		<div class="container hero-inner">
			<div>
			<span class="hero-pill">Paintless Dent Repair Shop — Cleveland &amp; Northeast Ohio | 7695 Granger Rd, Cleveland OH 44125</span>
				<h1>Cleveland's trusted paintless dent repair &amp; hail damage shop</h1>
				<p>
					All Dent PDR's repair shop at <strong>7695 Granger Rd, Cleveland, OH 44125</strong> serves the Greater
					Cleveland area and all of Northeast Ohio. We restore hail-damaged vehicles with factory-quality paintless
					dent repair — no repainting, no guesswork, just results your insurance company will approve.
				</p>
				<div class="button-row">
					<a class="button primary" href="/contact">Request an Inspection</a>
					<a class="button ghost" href="/services">Our Services</a>
				</div>
			</div>
			<div class="hero-card">
				<h3>Why Cleveland-area drivers choose All Dent PDR</h3>
				<ul>
					<li>Certified paintless dent repair technicians</li>
					<li>Premium, detail-first workmanship on every panel</li>
					<li>Nationwide storm response — we come to you</li>
					<li>Preserve your factory paint &amp; vehicle value</li>
					<li>Insurance-approved repairs with direct billing</li>
					<li>Inspection-based pricing for accurate repair planning</li>
				</ul>
				<p class="tag">Shop: 7695 Granger Rd, Cleveland, OH 44125</p>
				<p>Trusted by drivers, dealerships, and insurance partners nationwide.</p>
			</div>
		</div>
	</section>

	<div class="trust-strip">
		<div class="trust-item"><strong>1,000+</strong><span>Vehicles Repaired</span></div>
		<div class="trust-item"><strong>Cleveland, OH</strong><span>Local Shop</span></div>
		<div class="trust-item"><strong>100%</strong><span>Paint Preserved</span></div>
		<div class="trust-item"><strong>Detail-First</strong><span>In-Person Evaluations</span></div>
	</div>

	<section class="section">
		<div class="container">
			<span class="section-label">Storm Response</span>
			<h2>Serving Greater Cleveland and all of Northeast Ohio from our south Cleveland shop</h2>
			<p>
				Our shop at <strong>7695 Granger Rd, Cleveland, OH 44125</strong> is conveniently located in south
				Cleveland near Garfield Heights, Cuyahoga Heights, and Newburgh Heights. Drop your vehicle off or
				take advantage of our mobile service for insurance-approved hail damage repair anywhere in Northeast Ohio.
			</p>
			<p>
				We serve Bedford, Parma, Maple Heights, Solon, Warrensville Heights, Twinsburg, Beachwood,
				and dozens of other communities across Cuyahoga and Summit counties.
				<a href="/service-area">See our full service area →</a>
			</p>
			<div class="button-row" style="justify-content: center;">
				<a class="button primary" href="/contact">Request an Inspection</a>
				<a class="button ghost" href="/service-area">View Service Area</a>
			</div>
		</div>
	</section>

	<section class="section alt">
		<div class="container">
			<span class="section-label">Our Services</span>
			<h2>Paintless dent repair services</h2>
			<p>Professional PDR solutions for every type of dent — from minor door dings to full hail storm recovery.</p>
			<div class="grid-3">
				<article class="card">
					<span class="tag">Door Dings</span>
					<h3>Parking lot dent repair</h3>
					<p>Quick paintless dent repair for small dings and creases — no fillers, no repainting, no hassle.</p>
				</article>
				<article class="card">
					<span class="tag">Hail Damage</span>
					<h3>Hail storm recovery</h3>
					<p>Systematic panel-by-panel hail dent repair that preserves your OEM factory finish. We deploy to storm-affected areas nationwide.</p>
				</article>
				<article class="card">
					<span class="tag">Minor Collision</span>
					<h3>Soft impact dent removal</h3>
					<p>Paintless repair for dents from low-speed collisions where the paint surface remains intact.</p>
				</article>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<span class="section-label">How It Works</span>
			<h2>The paintless dent repair process</h2>
			<p>From estimate to finished repair — here's what to expect when you choose All Dent PDR.</p>
			<div class="process-grid">
				<div class="process-step card">
					<h3>Schedule an Inspection</h3>
					<p>Tell us about the damage and your location so we can arrange the right next step.</p>
				</div>
				<div class="process-step card">
					<h3>Get Your Quote</h3>
					<p>Receive transparent pricing with no hidden fees or surprises.</p>
				</div>
				<div class="process-step card">
					<h3>We Come to You</h3>
					<p>Our mobile PDR technicians arrive at your location — home, work, or dealership.</p>
				</div>
				<div class="process-step card">
					<h3>Flawless Finish</h3>
					<p>Drive away with factory-quality results. Your paint stays original, your value stays intact.</p>
				</div>
			</div>
		</div>
	</section>

	<section class="section alt">
		<div class="container">
			<span class="section-label">Our Work</span>
			<h2>Before &amp; after paintless dent repair results</h2>
			<p>Real repairs from real customers — see the difference professional PDR makes.</p>
			<div class="gallery-grid">
				<div class="card">
					<span class="tag">Door Ding</span>
					<BeforeAfter 
						client:load 
						before="/images/topdoorbefore.jpg" 
						after="/images/topdoorafter.jpg" 
						alt="Paintless dent repair Cincinnati - Door ding removal before and after showing restored factory finish"
					/>
				</div>
				<div class="card">
					<span class="tag">Hood Dent</span>
					<BeforeAfter 
						client:load 
						before="/images/pdrhoodbefore.png" 
						after="/images/pdrhoodafter.png" 
						alt="Hood dent paintless repair Cincinnati - Before and after PDR technique without repainting"
					/>
				</div>
				<div class="card">
					<span class="tag">Side Dent</span>
					<BeforeAfter 
						client:load 
						before="/images/sidedentbefore.jpg" 
						after="/images/sidedentafter.jpg" 
						alt="Side panel dent repair Cincinnati - PDR before after showing seamless paintless restoration"
					/>
				</div>
				<div class="card">
					<span class="tag">Hail Damage</span>
					<BeforeAfter 
						client:load 
						before="/images/haildamangetopbefore.jpg" 
						after="/images/haildamagetopafter.jpg" 
						alt="Hail damage repair Cincinnati - Before and after paintless dent removal from storm damage"
					/>
				</div>
				<div class="card">
					<span class="tag">Trunk Dent</span>
					<BeforeAfter 
						client:load 
						before="/images/denttrunkbefore.png" 
						after="/images/denttrunkafter.png" 
						alt="Trunk lid dent repair Cincinnati - Paintless dent repair before after comparison"
					/>
				</div>
				<div class="card">
					<span class="tag">Side Panel</span>
					<BeforeAfter 
						client:load 
						before="/images/sidepaneldentbefore.png" 
						after="/images/sidepaneldentafter.png" 
						alt="Car side panel dent repair Cincinnati - Professional PDR results preserve original paint"
					/>
				</div>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<span class="section-label">Why AllDent</span>
			<h2>Why choose AllDent for paintless dent repair?</h2>
			<p>Mobile, trusted, and quality-driven — here's what sets us apart from high-volume hail shops and traditional body repair.</p>
			<div class="grid-3">
				<article class="card">
					<h3>Premium craftsmanship</h3>
					<p>We focus on clean metal finishing, precise tool work, and panel-by-panel quality control so the final result looks right under real light.</p>
				</article>
				<article class="card">
					<h3>No gimmick-first sales</h3>
					<p>Some companies lead with promotions. We lead with repair quality, honest assessments, and workmanship that protects your vehicle's finish and value.</p>
				</article>
				<article class="card">
					<h3>Factory finish preserved</h3>
					<p>Our PDR techniques keep your original paint intact, protecting your vehicle's resale value and avoiding unnecessary refinishing.</p>
				</article>
			</div>
		</div>
	</section>

	<section class="section alt">
		<div class="container">
			<span class="section-label">Testimonials</span>
			<h2>What our customers say</h2>
			<p>Real feedback from drivers and dealerships who trust All Dent PDR.</p>
			<div class="testimonial-grid">
				<blockquote class="testimonial-card">
					<div class="testimonial-stars">★★★★★</div>
					<p class="testimonial-text">"AllDent came out after a massive hail storm and fixed every dent on my truck. You can't even tell it was damaged. They saved me thousands compared to a body shop."</p>
					<footer class="testimonial-author">
						<strong>Mike R.</strong>
						<span>Dallas, TX — Hail Damage Repair</span>
					</footer>
				</blockquote>
				<blockquote class="testimonial-card">
					<div class="testimonial-stars">★★★★★</div>
					<p class="testimonial-text">"Super professional and fast. They came to my office parking lot, fixed a door ding in under an hour, and it looks perfect. Highly recommend All Dent PDR."</p>
					<footer class="testimonial-author">
						<strong>Sarah T.</strong>
						<span>Cincinnati, OH — Door Ding Removal</span>
					</footer>
				</blockquote>
				<blockquote class="testimonial-card">
					<div class="testimonial-stars">★★★★★</div>
					<p class="testimonial-text">"We use AllDent for all our lot damage repairs. They're reliable, the pricing is fair, and the results are flawless every time. Our go-to PDR team."</p>
					<footer class="testimonial-author">
						<strong>James K.</strong>
						<span>Louisville, KY — Dealership Partner</span>
					</footer>
				</blockquote>
			</div>
		</div>
	</section>

	<section class="cta-banner">
		<div class="container">
			<h2>Hail damage anywhere in Northeast Ohio? We'll come to you.</h2>
			<p>Tell us where the storm hit and what vehicle was affected. We serve the entire Greater Cleveland area and deploy nationwide for major hail events.</p>
			<div class="button-row" style="justify-content: center;">
				<a class="button primary" href="/contact">Request an Inspection</a>
				<a class="button ghost" href="tel:18554255336">Call 1-855-425-5336</a>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<h2>Paintless dent repair FAQ</h2>
			<div class="faq-list">
				<details class="faq-item">
					<summary>What is paintless dent repair?</summary>
					<p>Paintless dent repair (PDR) is a technique that removes dents from vehicle panels without sanding, filling, or repainting. A technician uses specialized tools to reshape the metal from behind the panel, preserving your factory paint finish.</p>
				</details>
				<details class="faq-item">
					<summary>How much does paintless dent repair cost near Cleveland, Ohio?</summary>
					<p>PDR cost depends on dent size, location, and accessibility. Small door dings typically range from $75–$150. Hail damage is quoted per panel after an inspection so we can price the repair accurately.</p>
				</details>
				<details class="faq-item">
					<summary>Where does All Dent PDR provide service?</summary>
					<p>All Dent PDR operates a shop at 7695 Granger Rd, Cleveland, OH 44125, serving Greater Cleveland and all of Northeast Ohio. We also deploy nationwide to areas affected by major hail storms, providing on-site paintless dent repair wherever storm damage occurs.</p>
				</details>
				<details class="faq-item">
					<summary>How long does a typical PDR repair take?</summary>
					<p>Most single-dent repairs are completed in 1–3 hours. Multi-panel hail damage may take a full day. We provide a timeline upfront so you can plan accordingly.</p>
				</details>
			</div>
		</div>
	</section>
</BaseLayout>
