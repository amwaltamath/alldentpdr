---
import BaseLayout from '../layouts/BaseLayout.astro';
import BeforeAfter from '../components/BeforeAfter.jsx';
import GoogleReviewsSection from '../components/GoogleReviewsSection.astro';
import { customerStories } from '../data/customer-stories';
import { getGoogleReviews } from '../lib/google-reviews';
import { BUSINESS, LEAD_CTA } from '../lib/business';

const title = 'Paintless Dent Repair Cleveland, OH | All Dent PDR';
const description = `All Dent PDR serves ${BUSINESS.regionLabel} with paintless dent repair, hail damage restoration, door dings, and insurance-supported PDR.`;
const faqItems = [
  { question: 'What areas does All Dent PDR serve?', answer: `We serve ${BUSINESS.regionLabel}, including Bedford, Parma, Solon, Garfield Heights, and surrounding communities. For large-scale storm deployment, see our nationwide hail response page.` },
  { question: 'What is paintless dent repair?', answer: 'Paintless dent repair (PDR) is a technique that removes dents from vehicle panels without sanding, filling, or repainting. A technician uses specialized tools to reshape the metal from behind the panel, preserving your factory paint finish.' },
  { question: 'How much does paintless dent repair cost near Cleveland, Ohio?', answer: 'PDR cost depends on dent size, location, and accessibility. Small door dings typically range from $75-$150. Hail damage is quoted per panel after an in-person inspection so we can price the repair accurately.' },
  { question: 'How long does a typical PDR repair take?', answer: 'Most single-dent repairs are completed in 1-3 hours. Multi-panel hail damage may take a full day. We provide a timeline upfront so you can plan accordingly.' }
];

const googleReviews = await getGoogleReviews();
const showStaticStories = googleReviews.source !== 'live' || googleReviews.reviews.length === 0;
---

<BaseLayout title={title} description={description} canonical="https://alldentpdr.com" faqItems={faqItems}>
	<section class="hero">
		<div class="container hero-inner">
			<div>
				<h1>Paintless Dent Repair &amp; Hail Damage Repair in Cleveland, OH</h1>
				<p>
					All Dent PDR is a professional paintless dent repair team serving <strong>{BUSINESS.regionLabel}</strong>
					— including Bedford, Garfield Heights, Parma, Independence, and Solon.
					We handle hail damage, door dings, and insurance-supported PDR while preserving your vehicle's factory paint.
				</p>
				<div class="button-row">
					<a class="button primary" href="/contact">Request an Inspection</a>
					<a class="button ghost" href="/paintless-dent-repair-cleveland-oh">Cleveland PDR Services</a>
					<a class="button ghost" href={LEAD_CTA.href}>{LEAD_CTA.label}</a>
				</div>
			</div>
			<div class="hero-card">
				<h3>Why Cleveland-area drivers choose All Dent PDR</h3>
				<ul>
					<li>Certified paintless dent repair technicians</li>
					<li>Premium, detail-first workmanship on every panel</li>
					<li>Local PDR across Northeast Ohio</li>
					<li>Preserve your factory paint &amp; vehicle value</li>
					<li>Insurance-approved repairs with direct billing</li>
					<li>Inspection-based pricing for accurate repair planning</li>
				</ul>
				<p class="tag">{BUSINESS.regionLabel}</p>
				<p>Trusted by drivers, dealerships, and insurance partners nationwide.</p>
			</div>
		</div>
	</section>

	<div class="trust-strip">
		<div class="trust-item"><strong>1,000+</strong><span>Vehicles Repaired</span></div>
		<div class="trust-item"><strong>Cleveland, OH</strong><span>Service Area</span></div>
		<div class="trust-item"><strong>100%</strong><span>Paint Preserved</span></div>
		<div class="trust-item"><strong>Detail-First</strong><span>In-Person Evaluations</span></div>
	</div>

	<section class="section">
		<div class="container">
			<span class="section-label">Storm Response</span>
			<h2>Serving Greater Cleveland and all of Northeast Ohio</h2>
			<p>
				We help drivers across south Cleveland, Garfield Heights, Cuyahoga Heights, and surrounding suburbs.
				Request a free hail inspection or contact us for insurance-approved paintless dent repair.
			</p>
			<p>
				We serve Bedford, Parma, Maple Heights, Solon, Warrensville Heights, Twinsburg, Beachwood,
				and dozens of other communities across Cuyahoga and Summit counties.
				<a href="/service-area">See our full service area →</a>
			</p>
			<div class="button-row" style="justify-content: center;">
				<a class="button primary" href="/contact">Request an Inspection</a>
				<a class="button ghost" href="/service-area">View Service Area</a>
			</div>
		</div>
	</section>

	<section class="section alt">
		<div class="container">
			<span class="section-label">Our Services</span>
			<h2>Hail damage repair specialists</h2>
			<p>All Dent PDR focuses on one thing — restoring hail-damaged vehicles to factory condition using paintless dent repair. No repainting, no shortcuts.</p>
			<div class="grid-3">
				<article class="card">
					<span class="tag">Assessment</span>
					<h3>Free hail damage inspection</h3>
					<p>Request an inspection online. We document every panel and give you a clear, itemized repair plan before any work begins.</p>
				</article>
				<article class="card">
					<span class="tag">Hail Damage Repair</span>
					<h3>Panel-by-panel PDR restoration</h3>
					<p>Systematic paintless dent repair across every affected panel — hood, roof, trunk, and doors — preserving your OEM factory finish throughout.</p>
				</article>
				<article class="card">
					<span class="tag">Insurance</span>
					<h3>Direct insurance billing</h3>
					<p>We work directly with your insurance company, handle the paperwork, and ensure the repair scope matches your approved claim.</p>
				</article>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<span class="section-label">How It Works</span>
			<h2>The paintless dent repair process</h2>
			<p>From estimate to finished repair — here's what to expect when you choose All Dent PDR.</p>
			<div class="process-grid">
				<div class="process-step card">
					<h3>Schedule an Inspection or Stop In</h3>
					<p>Call or fill out our form — we respond quickly with next steps for your inspection and estimate.</p>
				</div>
				<div class="process-step card">
					<h3>Get Your Quote</h3>
					<p>Receive transparent, inspection-based pricing with no hidden fees or surprises.</p>
				</div>
				<div class="process-step card">
					<h3>We Work With Your Insurance</h3>
					<p>We handle direct billing with most major carriers so you don't have to chase paperwork.</p>
				</div>
				<div class="process-step card">
					<h3>Flawless Finish</h3>
					<p>Drive away with factory-quality results. Your paint stays original, your value stays intact.</p>
				</div>
			</div>
		</div>
	</section>

	<section class="section alt">
		<div class="container">
			<span class="section-label">Our Work</span>
			<h2>Before &amp; after paintless dent repair results</h2>
			<p>Real repairs from real customers — see the difference professional PDR makes.</p>
			<div class="gallery-grid">
				<div class="card">
					<span class="tag">Hail Damage</span>
					<BeforeAfter 
						client:visible 
						before="/images/alldentbefore.jpg" 
						after="/images/alldentafter.jpg" 
						alt="Hail damage repair Cleveland OH - All Dent PDR before and after paintless dent restoration"
					/>
				</div>
				<div class="card">
					<span class="tag">Door Ding</span>
					<BeforeAfter 
						client:visible 
						before="/images/topdoorbefore.jpg" 
						after="/images/topdoorafter.jpg" 
						alt="Paintless dent repair Cleveland OH - Door ding removal before and after showing restored factory finish"
					/>
				</div>
				<div class="card">
					<span class="tag">Hood Dent</span>
					<BeforeAfter 
						client:visible 
						before="/images/pdrhoodbefore.png" 
						after="/images/pdrhoodafter.png" 
						alt="Hood dent paintless repair Cleveland OH - Before and after PDR technique without repainting"
					/>
				</div>
				<div class="card">
					<span class="tag">Side Dent</span>
					<BeforeAfter 
						client:visible 
						before="/images/sidedentbefore.jpg" 
						after="/images/sidedentafter.jpg" 
						alt="Side panel dent repair Cleveland OH - PDR before after showing seamless paintless restoration"
					/>
				</div>
				<div class="card">
					<span class="tag">Hail Damage</span>
					<BeforeAfter 
						client:visible 
						before="/images/haildamangetopbefore.jpg" 
						after="/images/haildamagetopafter.jpg" 
						alt="Hail damage repair Cleveland OH - Before and after paintless dent removal from storm damage"
					/>
				</div>
				<div class="card">
					<span class="tag">Trunk Dent</span>
					<BeforeAfter 
						client:visible 
						before="/images/denttrunkbefore.png" 
						after="/images/denttrunkafter.png" 
						alt="Trunk lid dent repair Cleveland OH - Paintless dent repair before after comparison"
					/>
				</div>
				<div class="card">
					<span class="tag">Side Panel</span>
					<BeforeAfter 
						client:visible 
						before="/images/sidepaneldentbefore.png" 
						after="/images/sidepaneldentafter.png" 
						alt="Car side panel dent repair Cleveland OH - Professional PDR results preserve original paint"
					/>
				</div>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<span class="section-label">Why AllDent</span>
			<h2>Why choose AllDent for paintless dent repair?</h2>
			<p>Shop-based, trusted, and quality-driven — here's what sets us apart from high-volume hail shops and traditional body repair.</p>
			<div class="grid-3">
				<article class="card">
					<h3>Premium craftsmanship</h3>
					<p>We focus on clean metal finishing, precise tool work, and panel-by-panel quality control so the final result looks right under real light.</p>
				</article>
				<article class="card">
					<h3>No gimmick-first sales</h3>
					<p>Some companies lead with promotions. We lead with repair quality, honest assessments, and workmanship that protects your vehicle's finish and value.</p>
				</article>
				<article class="card">
					<h3>Factory finish preserved</h3>
					<p>Our PDR techniques keep your original paint intact, protecting your vehicle's resale value and avoiding unnecessary refinishing.</p>
				</article>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<span class="section-label">Local Services</span>
			<h2>Paintless dent repair across Northeast Ohio</h2>
			<p>Explore dedicated service pages for the repairs and markets that matter most.</p>
			<div class="grid-3">
				<article class="card">
					<span class="tag">Cleveland</span>
					<h3><a href="/paintless-dent-repair-cleveland-oh">Paintless Dent Repair Cleveland</a></h3>
					<p>Door dings, hail dents, creases, and minor collision damage across the Cleveland area.</p>
				</article>
				<article class="card">
					<span class="tag">Hail Damage</span>
					<h3><a href="/hail-damage-repair-cleveland">Hail Damage Repair Cleveland</a></h3>
					<p>Storm-season hail repair with insurance billing and factory-finish PDR restoration.</p>
				</article>
				<article class="card">
					<span class="tag">Bedford</span>
					<h3><a href="/bedford-paintless-dent-repair">Paintless Dent Repair Bedford</a></h3>
					<p>Fast service for Bedford drivers — same technicians and premium repair standard.</p>
				</article>
				<article class="card">
					<span class="tag">Bedford Hail</span>
					<h3><a href="/bedford-hail-damage-repair">Hail Damage Repair Bedford</a></h3>
					<p>Post-storm hail inspections and panel-by-panel repair for Bedford-area drivers.</p>
				</article>
				<article class="card">
					<span class="tag">Parma</span>
					<h3><a href="/paintless-dent-repair/parma">PDR Parma, OH</a></h3>
					<p>Convenient access from Parma with walk-in inspections and direct insurance billing.</p>
				</article>
				<article class="card">
					<span class="tag">All Areas</span>
					<h3><a href="/service-area">Full Service Area</a></h3>
					<p>Garfield Heights, Maple Heights, Solon, Independence, Twinsburg, Beachwood, and more.</p>
				</article>
			</div>
		</div>
	</section>

	<section class="section alt">
		<div class="container">
			<span class="section-label">Testimonials</span>
			<h2>What our customers say</h2>
			<p>Real feedback from drivers and dealerships who trust All Dent PDR.</p>
			<GoogleReviewsSection data={googleReviews} maxReviews={3} />
			{showStaticStories && (
				<div class="testimonial-grid" style="margin-top: 24px;">
					{customerStories.slice(0, 3).map((story) => (
						<blockquote class="testimonial-card">
							<div class="testimonial-stars">★★★★★</div>
							<p class="testimonial-text">"{story.quote}"</p>
							<footer class="testimonial-author">
								<strong>{story.name}</strong>
								<span>{story.detail}</span>
							</footer>
						</blockquote>
					))}
				</div>
			)}
			<p style="margin-top: 18px; text-align: center;">
				<a href="/testimonials">See all customer stories →</a>
			</p>
		</div>
	</section>

	<section class="cta-banner">
		<div class="container">
			<h2>Hail damage in Northeast Ohio? Request an inspection.</h2>
			<p>Contact us for a free inspection — or tell us about storm damage and we'll help you plan the repair. <a href="/nationwide-hail-damage-repair">Nationwide storm response</a> is available for commercial and fleet partners.</p>
			<div class="button-row" style="justify-content: center;">
				<a class="button primary" href="/contact">Request an Inspection</a>
				<a class="button ghost" href="/contact">Get free estimate</a>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<h2>Paintless dent repair FAQ</h2>
			<div class="faq-list">
				<details class="faq-item">
					<summary>What is paintless dent repair?</summary>
					<p>Paintless dent repair (PDR) is a technique that removes dents from vehicle panels without sanding, filling, or repainting. A technician uses specialized tools to reshape the metal from behind the panel, preserving your factory paint finish.</p>
				</details>
				<details class="faq-item">
					<summary>How much does paintless dent repair cost near Cleveland, Ohio?</summary>
					<p>PDR cost depends on dent size, location, and accessibility. Small door dings typically range from $75–$150. Hail damage is quoted per panel after an inspection so we can price the repair accurately.</p>
				</details>
				<details class="faq-item">
					<summary>Where does All Dent PDR provide service?</summary>
					<p>All Dent PDR serves Greater Cleveland & Northeast Ohio, serving Greater Cleveland and all of Northeast Ohio. We also deploy nationwide to areas affected by major hail storms, providing on-site paintless dent repair wherever storm damage occurs.</p>
				</details>
				<details class="faq-item">
					<summary>How long does a typical PDR repair take?</summary>
					<p>Most single-dent repairs are completed in 1–3 hours. Multi-panel hail damage may take a full day. We provide a timeline upfront so you can plan accordingly.</p>
				</details>
			</div>
		</div>
	</section>
</BaseLayout>
