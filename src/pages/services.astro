---
import BaseLayout from '../layouts/BaseLayout.astro';
import BeforeAfter from '../components/BeforeAfter.jsx';

const title = 'Paintless Dent Repair Services | Hail Damage Repair Shop Bedford &amp; Cleveland, OH | All Dent PDR';
const description = 'Professional paintless dent repair and hail damage repair at All Dent PDR’s shop — 7695 Granger Rd, Cleveland, OH 44125. Serving Bedford, OH and 20+ Northeast Ohio communities. Call 1-855-425-5336.';
const breadcrumbs = [
  { name: 'Home', url: 'https://alldentpdr.com' },
  { name: 'Services', url: 'https://alldentpdr.com/services' }
];
const faqItems = [
  { question: 'Where is All Dent PDR’s shop located?', answer: 'Our shop is at 7695 Granger Rd, Cleveland, OH 44125 — just minutes from Bedford, OH. We serve 20+ communities across Northeast Ohio and also offer mobile service nationwide for large hail events.' },
  { question: 'How much does paintless dent repair cost near Bedford, Ohio?', answer: 'PDR pricing depends on dent size, location, and panel accessibility. Small door dings typically start around $75-$150, while hail damage is quoted per panel after an in-person inspection at our shop.' },
  { question: 'How long does paintless dent repair take?', answer: 'Most single-dent repairs are completed in 1-3 hours. Hail damage with multiple panels may take 1-3 days. We provide realistic timelines upfront so you can plan.' },
  { question: 'Will PDR damage my factory paint?', answer: 'No. Paintless dent repair preserves your original factory finish. We reshape the metal from behind the panel without using fillers, sanding, or repainting.' },
  { question: 'What types of dents can be fixed with PDR?', answer: 'PDR works best on dents where the paint surface is intact — including door dings, hail dents, minor collision dents, and creases. Very sharp or stretched-metal dents may require conventional repair.' },
  { question: 'Do you work with insurance companies?', answer: 'Yes! All Dent PDR works directly with most major insurance carriers including State Farm, Allstate, Progressive, and GEICO. We handle documentation and billing — you typically only pay your deductible.' }
];
---

<BaseLayout title={title} description={description} canonical="https://alldentpdr.com/services" breadcrumbs={breadcrumbs} faqItems={faqItems}>
  <section class="page-hero page-hero--services services-hero-shell">
    <div class="container">
      <span class="section-label">Our Services — Bedford &amp; Northeast Ohio</span>
      <h1>Paintless dent repair &amp; hail damage repair in Northeast Ohio</h1>
      <p>All Dent PDR's shop at <strong>7695 Granger Rd, Cleveland, OH 44125</strong> serves Bedford, OH and 20+ surrounding communities. From single door dings to full hail storm recovery — expert PDR with insurance direct billing and free written estimates.</p>
      <div class="button-row" style="justify-content:center;margin-top:16px;">
        <a class="button primary" href="/service-area">View All Service Areas</a>
        <a class="button ghost" href="/contact">Schedule a Visit</a>
      </div>
    </div>
  </section>

  <section class="services-kpi-strip" aria-label="Service highlights">
    <div class="container services-kpi-grid">
      <div class="services-kpi-item"><strong>5 min</strong><span>From Bedford</span></div>
      <div class="services-kpi-item"><strong>1,000+</strong><span>Vehicles Repaired</span></div>
      <div class="services-kpi-item"><strong>20+</strong><span>NE Ohio Areas</span></div>
      <div class="services-kpi-item"><strong>Insurance</strong><span>Direct Billing</span></div>
    </div>
  </section>

  <section class="section alt services-lane-section">
    <div class="container grid-3">
      <article class="card services-lane-card">
        <span class="tag">Door Dings</span>
        <h3>Paintless door ding repair</h3>
        <p>Professional PDR for parking lot dents and light creases that preserves your factory paint finish.</p>
      </article>
      <article class="card services-lane-card">
        <span class="tag">Hail Damage</span>
        <h3>Hail storm damage repair — nationwide</h3>
        <p>We deploy to storm-affected areas across the U.S. for systematic panel-by-panel paintless dent repair with fast turnaround.</p>
      </article>
      <article class="card services-lane-card">
        <span class="tag">Minor Collision</span>
        <h3>Collision dent removal</h3>
        <p>Paintless repair for soft impact dents from low-speed bumps where paint remains undamaged.</p>
      </article>
    </div>
  </section>

  <section class="section services-process-section">
    <div class="container">
      <span class="section-label">How It Works</span>
      <h2>The paintless dent repair process</h2>
      <p>Simple, transparent, and efficient — start to finish.</p>
      <div class="process-grid">
        <div class="process-step card services-process-card">
          <h3>Request an Inspection</h3>
          <p>Tell us about the damage, vehicle, and location so we can set up the right evaluation.</p>
        </div>
        <div class="process-step card services-process-card">
          <h3>Get Your Quote</h3>
          <p>Receive upfront pricing — no hidden fees, no upsells.</p>
        </div>
        <div class="process-step card services-process-card">
          <h3>Bring It to Our Shop</h3>
          <p>Visit All Dent PDR at 7695 Granger Rd, Cleveland, OH 44125 for a professional in-shop repair.</p>
        </div>
        <div class="process-step card services-process-card">
          <h3>Flawless Finish</h3>
          <p>Your vehicle is restored to factory condition with original paint intact.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Real repairs from across the country</h2>
      <div class="gallery-grid">
        <div class="card">
          <span class="tag">Door Ding</span>
          <BeforeAfter 
            client:visible 
            before="/images/topdoorbefore.jpg" 
            after="/images/topdoorafter.jpg" 
            alt="Paintless dent repair Cleveland OH - Door ding removal before and after showing restored factory finish"
          />
        </div>
        <div class="card">
          <span class="tag">Hood Dent</span>
          <BeforeAfter 
            client:visible 
            before="/images/pdrhoodbefore.png" 
            after="/images/pdrhoodafter.png" 
            alt="Hood dent paintless repair Cleveland OH - Before and after PDR technique without repainting"
          />
        </div>
        <div class="card">
          <span class="tag">Hail Damage</span>
          <BeforeAfter 
            client:visible 
            before="/images/haildamangetopbefore.jpg" 
            after="/images/haildamagetopafter.jpg" 
            alt="Hail damage repair Cleveland OH - Before and after paintless dent removal from storm damage"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <span class="section-label">About PDR</span>
      <h2>What is paintless dent repair?</h2>
      <p>
        Paintless dent repair (PDR) is a specialized technique where trained technicians access the backside of your vehicle's panel 
        and gently reshape the metal with precision tools. Unlike traditional body shop methods, 
        PDR preserves your factory paint, reduces repair time significantly, and protects your vehicle's resale value. 
        It is the industry-preferred method whenever the paint surface is intact.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="section-label">Why We're Different</span>
      <h2>Premium dent repair, not rushed volume work</h2>
      <p>
        After major hail storms, many repair companies compete on speed or promotions alone. All Dent PDR is built around
        the quality of the finished repair. We take the time to read each panel correctly, remove dents cleanly, and inspect
        the vehicle in proper lighting so the result looks right when you get it back.
      </p>
      <p>
        We prioritize Bedford, Garfield Heights, Maple Heights, Independence, Parma, Solon,
        Warrensville Heights, Oakwood Village, Northfield, and 15+ additional Northeast Ohio communities.
        <a href="/service-area" style="color:var(--rust);font-weight:600;">See the full service area list.</a>
      </p>
      <div class="grid-3">
        <article class="card">
          <h3>Detail-first repairs</h3>
          <p>We do not stop at getting dents "mostly out." We work for a clean, consistent finish across the full panel.</p>
        </article>
        <article class="card">
          <h3>Honest recommendations</h3>
          <p>We keep the conversation focused on the right repair plan for your vehicle, not gimmicks or pressure tactics.</p>
        </article>
        <article class="card">
          <h3>Better final result</h3>
          <p>Our process is designed to preserve factory paint, reduce visible distortion, and deliver premium-quality hail repair.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Frequently asked questions about paintless dent repair</h2>
      <div class="faq-list">
        <details class="faq-item">
          <summary>How much does paintless dent repair cost in Cleveland, OH?</summary>
          <p>PDR pricing depends on dent size, location, and panel accessibility. Small door dings typically start around $75–$150, while hail damage is quoted per panel after an inspection.</p>
        </details>
        <details class="faq-item">
          <summary>How long does paintless dent repair take?</summary>
          <p>Most single-dent repairs are completed in 1–3 hours. Hail damage with multiple panels may take a full day. We provide realistic timelines upfront so you can plan.</p>
        </details>
        <details class="faq-item">
          <summary>Will PDR damage my factory paint?</summary>
          <p>No. Paintless dent repair preserves your original factory finish. We reshape the metal from behind the panel without using fillers, sanding, or repainting.</p>
        </details>
        <details class="faq-item">
          <summary>What types of dents can be fixed with PDR?</summary>
          <p>PDR works best on dents where the paint surface is intact — including door dings, hail dents, minor collision dents, and creases. Very sharp or stretched-metal dents may require conventional repair.</p>
        </details>
        <details class="faq-item">
          <summary>Do you work with insurance companies?</summary>
          <p>Yes! All Dent PDR works directly with most major carriers including State Farm, Allstate, Progressive, and GEICO. We handle documentation and billing — you typically only pay your deductible.</p>
        </details>
      </div>
      <div class="button-row" style="justify-content: center;">
        <a class="button primary" href="/contact">Request an Inspection</a>
        <a class="button ghost" href="/blog">Read the Blog</a>
      </div>
    </div>
  </section>

  <section class="cta-banner services-cta-shell">
    <div class="container">
      <h2>Visit our shop or call for a same-day response</h2>
      <p>All Dent PDR · 7695 Granger Rd, Cleveland, OH 44125 · Serving Bedford, OH and 20+ Northeast Ohio communities</p>
      <div class="button-row" style="justify-content: center;">
        <a class="button primary" href="/contact">Schedule at Our Shop</a>
        <a class="button ghost" href="tel:18554255336">Call 1-855-425-5336</a>
      </div>
    </div>
  </section>
</BaseLayout>
