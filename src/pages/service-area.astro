---
import BaseLayout from '../layouts/BaseLayout.astro';
import { serviceAreas } from '../data/serviceAreas';

const title = 'Hail Damage Repair Service Area | All Dent PDR | Bedford & Cleveland, OH';
const description = 'All Dent PDR serves 20+ communities across Northeast Ohio from our shop at 7695 Granger Rd, Cleveland, OH 44125. See if we cover your city — Bedford, Parma, Solon, Garfield Heights, and more.';
const canonical = 'https://alldentpdr.com/service-area';

const breadcrumbs = [
  { name: 'Home', url: 'https://alldentpdr.com' },
  { name: 'Service Area', url: canonical },
];

const faqItems = [
  {
    question: 'What areas does All Dent PDR serve?',
    answer: 'All Dent PDR serves 20+ communities across Northeast Ohio from our shop at 7695 Granger Rd, Cleveland, OH 44125. Primary service areas include Bedford, Garfield Heights, Maple Heights, Parma, Solon, Independence, Warrensville Heights, and many more.',
  },
  {
    question: 'Do you offer service outside of Bedford?',
    answer: 'Yes. In addition to Bedford, we serve 20+ Northeast Ohio communities from our shop at 7695 Granger Rd, Cleveland, OH 44125. If your area was hit by hail, contact us and we will confirm availability quickly.',
  },
  {
    question: 'My city is not listed — do you still serve me?',
    answer: 'Likely yes. If you are in Northeast Ohio, we probably serve your area. Contact us at 1-855-425-5336 or via our contact form and we will confirm quickly.',
  },
];

const serviceAreaSchema = {
  '@context': 'https://schema.org',
  '@type': ['AutoRepair', 'LocalBusiness'],
  name: 'All Dent PDR — Hail Damage Repair Northeast Ohio',
  description: 'Expert paintless dent repair and hail damage repair shop serving 20+ communities across Northeast Ohio from 7695 Granger Rd, Cleveland, OH 44125.',
  url: 'https://alldentpdr.com/service-area',
  telephone: '1-855-425-5336',
  email: 'alldentpdr@gmail.com',
  image: 'https://alldentpdr.com/images/logo-branded.svg',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '7695 Granger Rd',
    addressLocality: 'Cleveland',
    addressRegion: 'OH',
    postalCode: '44125',
    addressCountry: 'US',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 41.3960,
    longitude: -81.6100,
  },
  areaServed: serviceAreas.map(c => ({ '@type': 'City', name: `${c.name}, OH` })),
  sameAs: ['https://share.google/7cCa7EhinPDCM8Owu', 'https://www.facebook.com/alldentpdr/'],
  priceRange: '$$',
  paymentAccepted: 'Cash, Credit Card, Insurance',
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '5',
    reviewCount: '47',
    bestRating: '5',
    worstRating: '1',
  },
};

// Sort cities by distance for display
const sorted = [...serviceAreas].sort((a, b) => a.distanceMiles - b.distanceMiles);
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  breadcrumbs={breadcrumbs}
  faqItems={faqItems}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(serviceAreaSchema)} />
  </Fragment>

  <!-- Hero -->
  <section class="page-hero container">
    <span class="section-label">Northeast Ohio Service Area</span>
    <h1>Hail damage repair serving 20+ communities near Bedford, OH</h1>
    <p>
      All Dent PDR's shop at <strong>7695 Granger Rd, Cleveland, OH 44125</strong> is the go-to paintless
      dent repair destination for drivers across Northeast Ohio. See if your city is in our coverage zone — 
      and if you don't see it, call us anyway.
    </p>
    <div class="button-row" style="justify-content:center;">
      <a class="button primary" href="/contact">Get a Free Estimate</a>
      <a class="button ghost" href="tel:18554255336">Call 1-855-425-5336</a>
    </div>
  </section>

  <!-- Trust strip -->
  <div class="trust-strip">
    <div class="trust-item"><strong>20+</strong><span>Cities Served</span></div>
    <div class="trust-item"><strong>1,000+</strong><span>Vehicles Repaired</span></div>
    <div class="trust-item"><strong>5★</strong><span>Customer Rating</span></div>
    <div class="trust-item"><strong>Insurance</strong><span>Approved Repairs</span></div>
  </div>

  <!-- City grid -->
  <section class="section">
    <div class="container">
      <span class="section-label">Service Communities</span>
      <h2>All cities we serve</h2>
      <p style="max-width:680px;">
        Every city below has a dedicated page with shop directions, drive times, and local details.
        All repairs are performed at or dispatched from our shop at 7695 Granger Rd, Cleveland, OH 44125.
      </p>

      <div class="service-area-grid">
        {sorted.map(city => (
          <a
            href={`/hail-damage-repair/${city.slug}`}
            class="city-card card"
          >
            <div class="city-card-header">
              <span class="city-name">{city.name}, OH</span>
              <span class="city-distance">{city.driveMinutes} min</span>
            </div>
            <p class="city-counties">{city.county} County · {city.zipCodes.join(', ')}</p>
            <p class="city-tagline">{city.tagline}</p>
            <span class="city-cta">View page →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Map section -->
  <section class="section alt">
    <div class="container">
      <span class="section-label">Find Us</span>
      <h2>Our shop — conveniently located for all of Northeast Ohio</h2>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:32px;align-items:start;" class="map-grid">
        <div>
          <p>
            Our repair shop sits along Granger Rd in Cleveland, with easy access from I-480,
            I-77, and Rockside Rd. Most Northeast Ohio communities are within a 20-minute drive.
          </p>
          <p><strong>Address:</strong><br />7695 Granger Rd<br />Cleveland, OH 44125</p>
          <p><strong>Hours:</strong><br />Mon–Fri: 8:00am – 6:00pm<br />Saturday: 9:00am – 2:00pm<br />Sunday: Closed</p>
          <p><strong>Phone:</strong> <a href="tel:18554255336" style="color:var(--rust);">1-855-425-5336</a></p>
          <p><strong>Email:</strong> <a href="mailto:alldentpdr@gmail.com" style="color:var(--rust);">alldentpdr@gmail.com</a></p>
          <div class="button-row" style="margin-top:20px;">
            <a class="button primary" href="/contact">Schedule a Visit</a>
            <a class="button ghost" href="https://maps.google.com/?q=7695+Granger+Rd+Cleveland+OH+44125" target="_blank" rel="noopener">Get Directions</a>
          </div>
        </div>
        <div style="border-radius:16px;overflow:hidden;border:1px solid #e8e0d8;">
          <iframe
            title="All Dent PDR shop location map — 7695 Granger Rd Cleveland OH 44125"
            src="https://maps.google.com/maps?q=7695+Granger+Rd+Cleveland+OH+44125&output=embed"
            width="100%"
            height="340"
            style="border:0;display:block;"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- Why PDR section -->
  <section class="section">
    <div class="container">
      <span class="section-label">Why PDR</span>
      <h2>Why Northeast Ohio drivers choose paintless dent repair</h2>
      <div class="grid-3">
        <article class="card">
          <h3>No repaint needed</h3>
          <p>When factory paint is intact, PDR restores your panels completely — no paint match issues, no Carfax flags, no depreciation from repaint.</p>
        </article>
        <article class="card">
          <h3>Insurance preferred</h3>
          <p>Most insurance carriers prefer PDR for hail claims because it's faster and more cost-effective. We handle billing directly.</p>
        </article>
        <article class="card">
          <h3>Faster turnaround</h3>
          <p>Most hail repairs are completed in 1–3 days at our shop versus weeks at a traditional body shop — less time without your vehicle.</p>
        </article>
        <article class="card">
          <h3>Resale value protected</h3>
          <p>Preserved factory paint means better trade-in and resale values. PDR is the smart choice for newer vehicles with higher market value.</p>
        </article>
        <article class="card">
          <h3>Certified technicians</h3>
          <p>Our PDR technicians are trained and certified — not rushed volume workers. Every repair meets a quality standard before leaving the shop.</p>
        </article>
        <article class="card">
          <h3>Free written estimates</h3>
          <p>You'll never be surprised by the final bill. We inspect, document, and provide a written estimate before any work begins.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section alt">
    <div class="container">
      <span class="section-label">FAQ</span>
      <h2>Service area questions</h2>
      <div style="display:flex;flex-direction:column;gap:16px;max-width:780px;margin:0 auto;">
        {faqItems.map(item => (
          <details style="background:white;border-radius:12px;padding:20px 24px;border:1px solid #e8e0d8;">
            <summary style="font-weight:600;cursor:pointer;font-size:1.05rem;">{item.question}</summary>
            <p style="margin-top:12px;color:#4a3f35;">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-banner">
    <div class="container">
      <h2>Your city in Northeast Ohio? We've got you covered.</h2>
      <p>
        All Dent PDR · 7695 Granger Rd, Cleveland, OH 44125 · Mon–Fri 8am–6pm · Sat 9am–2pm<br />
        Walk-ins welcome · Free estimates · Insurance claims handled · 20+ communities served
      </p>
      <div class="button-row" style="justify-content:center;">
        <a class="button primary" href="/contact">Schedule at Our Shop</a>
        <a class="button ghost" href="tel:18554255336">Call 1-855-425-5336</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .service-area-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 36px;
  }
  @media (max-width: 900px) {
    .service-area-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 580px) {
    .service-area-grid { grid-template-columns: 1fr; }
  }
  .city-card {
    text-decoration: none;
    color: var(--ink);
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .city-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(176, 82, 43, 0.15);
  }
  .city-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .city-name {
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--rust);
  }
  .city-distance {
    font-size: 0.8rem;
    background: var(--rust);
    color: #fff;
    padding: 3px 9px;
    border-radius: 20px;
    font-weight: 600;
  }
  .city-counties {
    font-size: 0.82rem;
    color: #888;
    margin: 0;
  }
  .city-tagline {
    font-size: 0.9rem;
    color: #4a3f35;
    margin: 0;
    line-height: 1.5;
  }
  .city-cta {
    font-weight: 600;
    color: var(--rust);
    font-size: 0.9rem;
    margin-top: auto;
  }
  .map-grid {
    grid-template-columns: 1fr 1fr;
  }
  @media (max-width: 720px) {
    .map-grid { grid-template-columns: 1fr; }
  }
</style>
