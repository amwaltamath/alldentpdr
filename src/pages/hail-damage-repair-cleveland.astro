        </p>

        <script>
          (function () {
            const p = new URLSearchParams(window.location.search);
            const keys = ['utm_source','utm_medium','utm_campaign','utm_content','utm_term'];
            const stored = JSON.parse(sessionStorage.getItem('alldent_utm') || '{}');
            let changed = false;
            keys.forEach((k) => { if (p.get(k)) { stored[k] = p.get(k); changed = true; } });
            if (!stored.referrer) { stored.referrer = document.referrer || ''; changed = true; }
            if (changed) sessionStorage.setItem('alldent_utm', JSON.stringify(stored));

            const form = document.getElementById('lp-form');
            const btn  = document.getElementById('lp-submit');
            const stat = document.getElementById('lp-status');

            form.addEventListener('submit', async (e) => {
              e.preventDefault();
              btn.disabled = true;
              btn.textContent = 'Sendingâ€¦';

              const eventId = `lead-${Date.now()}-${Math.random().toString(36).slice(2,8)}`;
              const data = Object.fromEntries(new FormData(form));
              data.event_id = eventId;
              data.location  = data.location || 'Cleveland, OH';

              const getCookie = (n) => (document.cookie.match('(^|;)\\s*' + n + '\\s*=\\s*([^;]+)') || [])[2] || '';
              data.fbc = getCookie('_fbc');
              data.fbp = getCookie('_fbp');
              Object.assign(data, JSON.parse(sessionStorage.getItem('alldent_utm') || '{}'));

              try {
                const res = await fetch('/api/contact', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify(data),
                });
                if (res.ok) {
                  form.reset();
                  stat.textContent = 'âœ“ Request sent! We\'ll be in touch within 2 hours.';
                  stat.style.color = '#16a34a';
                  if (typeof fbq === 'function') fbq('track', 'Lead', {}, { eventID: eventId });
                  if (typeof gtag === 'function') gtag('event', 'conversion', { send_to: 'AW-18153754648/o4LuCOyPm60cEJigsdBD' });
                } else {
                  stat.textContent = 'Something went wrong â€” please call 1-855-425-5336.';
                  stat.style.color = '#dc2626';
                  btn.disabled = false;
                  btn.textContent = 'Request Free Inspection';
                }
              } catch {
                stat.textContent = 'Something went wrong â€” please call 1-855-425-5336.';
                stat.style.color = '#dc2626';
                btn.disabled = false;
                btn.textContent = 'Request Free Inspection';
              }
              stat.style.display = 'block';
            });
          })();
        </script>
      </div>
    </div>
