        <h2 style="color:#1a1410;font-size:1.35rem;margin:0 0 6px;font-family:Georgia,serif;">Request your free inspection</h2>
        <p style="color:#6b5c52;font-size:0.88rem;margin:0 0 20px;">We'll reply within 2 hours during business hours.</p>

        <form id="lp-form" style="display:flex;flex-direction:column;gap:14px;">
          <label style="display:flex;flex-direction:column;gap:4px;font-size:0.87rem;font-weight:600;color:#3a2e28;">
            Name *
            <input type="text" name="name" placeholder="Your name" required style="padding:10px 14px;border:1.5px solid #d8cfc8;border-radius:8px;font-size:0.95rem;outline:none;transition:border-color 0.2s;" />
          </label>
          <label style="display:flex;flex-direction:column;gap:4px;font-size:0.87rem;font-weight:600;color:#3a2e28;">
            Phone
