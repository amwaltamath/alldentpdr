---
import BaseLayout from '../layouts/BaseLayout.astro';
import BeforeAfter from '../components/BeforeAfter.jsx';

const title = 'Hail Damage Repair Cleveland OH | Free Inspection | All Dent PDR';
const description = 'Hail hit your car in Cleveland? All Dent PDR at 7695 Granger Rd, Cleveland, OH 44125 restores hail-damaged vehicles with paintless dent repair. Free inspection, direct insurance billing, factory finish preserved. Call 1-855-425-5336.';
const canonical = 'https://alldentpdr.com/hail-damage-repair-cleveland';

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': ['AutoRepair', 'LocalBusiness'],
  name: 'All Dent PDR â€” Hail Damage Repair Cleveland',
  description: 'Paintless hail damage repair shop in Cleveland, OH serving Parma, Garfield Heights, Maple Heights, Solon, Bedford, and Northeast Ohio.',
  url: canonical,
  telephone: '1-855-425-5336',
  email: 'admin@alldentpdr.com',
  image: 'https://alldentpdr.com/images/logo-branded.svg',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '7695 Granger Rd',
    addressLocality: 'Cleveland',
    addressRegion: 'OH',
    postalCode: '44125',
    addressCountry: 'US'
  },
  geo: { '@type': 'GeoCoordinates', latitude: 41.3960, longitude: -81.6100 },
  areaServed: ['Cleveland, OH', 'Parma, OH', 'Garfield Heights, OH', 'Maple Heights, OH', 'Bedford, OH', 'Solon, OH', 'Warrensville Heights, OH', 'Strongsville, OH'],
  priceRange: '$$',
  paymentAccepted: 'Cash, Credit Card, Insurance',
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday'], opens: '08:00', closes: '18:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Saturday'], opens: '09:00', closes: '14:00' }
  ],
  aggregateRating: { '@type': 'AggregateRating', ratingValue: '5', reviewCount: '47', bestRating: '5', worstRating: '1' }
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'Can hail damage be fixed without repainting?', acceptedAnswer: { '@type': 'Answer', text: 'Yes â€” if the paint is intact, paintless dent repair (PDR) reshapes the metal from behind, preserving your factory finish with no sanding or repainting.' } },
    { '@type': 'Question', name: 'Does insurance cover hail damage in Cleveland?', acceptedAnswer: { '@type': 'Answer', text: 'Most comprehensive auto policies cover hail damage after your deductible. We work directly with State Farm, Progressive, Allstate, and most major carriers to handle the paperwork for you.' } },
    { '@type': 'Question', name: 'How long does hail damage repair take?', acceptedAnswer: { '@type': 'Answer', text: 'Light hail repairs are often completed same-day or next day. Heavy storm damage with multiple panels typically takes 1â€“3 days, depending on dent count and insurance approval.' } },
    { '@type': 'Question', name: 'Where is All Dent PDR located?', acceptedAnswer: { '@type': 'Answer', text: 'We are at 7695 Granger Rd, Cleveland, OH 44125 â€” easily accessible from Parma, Garfield Heights, Bedford, Maple Heights, Solon, and all of Northeast Ohio.' } }
  ]
};
---

<BaseLayout title={title} description={description} canonical={canonical} bare={true}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Header -->
  <header style="background:#fff;border-bottom:3px solid #fc1317;padding:14px 0;position:sticky;top:0;z-index:100;box-shadow:0 2px 12px rgba(0,0,0,0.08);">
