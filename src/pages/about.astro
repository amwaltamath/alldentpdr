---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'About All Dent PDR | Hail Damage Repair Shop — Bedford &amp; Cleveland, OH';
const description = 'All Dent PDR operates a paintless dent repair shop at 7695 Granger Rd, Cleveland, OH 44125, serving Bedford, OH and Northeast Ohio. Expert PDR technicians, transparent inspections, and factory-quality hail damage repair.';
const breadcrumbs = [
  { name: 'Home', url: 'https://alldentpdr.com' },
  { name: 'About', url: 'https://alldentpdr.com/about' }
];
---

<BaseLayout title={title} description={description} canonical="https://alldentpdr.com/about" breadcrumbs={breadcrumbs}>
  <section class="page-hero container">
    <span class="section-label">About Us</span>
    <h1>Northeast Ohio's paintless dent repair &amp; hail damage shop</h1>
    <p>All Dent PDR operates a full-service paintless dent repair shop at <strong>7695 Granger Rd, Cleveland, OH 44125</strong>, serving Bedford, OH and all of Northeast Ohio. We also deploy mobile teams nationwide wherever storms hit.</p>
  </section>

  <section class="section alt">
    <div class="container grid-3">
      <article class="card">
        <h3>Storm-ready mobile service</h3>
        <p>When hail strikes anywhere in the U.S., we deploy to affected areas and repair vehicles on location.</p>
      </article>
      <article class="card">
        <h3>Clear communication</h3>
        <p>Accurate inspections, realistic timelines, and straight answers from start to finish.</p>
      </article>
      <article class="card">
        <h3>Local shop in Northeast Ohio</h3>
        <p>Our repair shop at 7695 Granger Rd, Cleveland, OH 44125 serves Bedford, OH and surrounding communities every day.</p>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="section-label">Why PDR</span>
      <h2>Why choose paintless dent repair?</h2>
      <p>
        Paintless dent repair preserves your factory paint, minimizes vehicle downtime, and typically costs less than conventional body repair.
        PDR is the preferred repair method when your paint surface is intact — it maintains your vehicle's original finish and protects resale value.
      </p>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <h2>Where we serve</h2>
      <p>All Dent PDR's shop is located just minutes from Bedford, OH at 7695 Granger Rd, Cleveland, OH 44125. Our mobile teams also cover the entire country.</p>
      <div class="grid-3">
        <article class="card">
          <h3>Bedford &amp; NE Ohio</h3>
          <p>Our home shop serves Bedford, Bedford Heights, Maple Heights, Garfield Heights, Solon, Warrensville Heights, Northfield, Twinsburg, and surrounding communities daily.</p>
        </article>
        <article class="card">
          <h3>Storm-affected areas</h3>
          <p>We travel to hail-impacted regions across the U.S. to provide on-site repair after major storms.</p>
        </article>
        <article class="card">
          <h3>Nationwide coverage</h3>
          <p>From the Midwest to the South and beyond — wherever hail damage happens, we can be there.</p>
        </article>
      </div>
      <div class="button-row" style="justify-content: center; margin-top: 32px;">
        <a class="button primary" href="/contact">Request an Inspection</a>
        <a class="button ghost" href="/services">View Services</a>
      </div>
    </div>
  </section>

  <section class="cta-banner">
    <div class="container">
      <h2>Need hail damage repair near Bedford, OH?</h2>
      <p>Visit our shop at 7695 Granger Rd, Cleveland, OH 44125 or request an inspection online — Northeast Ohio's trusted paintless dent repair experts.</p>
      <div class="button-row" style="justify-content: center;">
        <a class="button primary" href="/contact">Contact Us Today</a>
        <a class="button ghost" href="tel:18554255336">Call 1-855-425-5336</a>
      </div>
    </div>
  </section>
</BaseLayout>
