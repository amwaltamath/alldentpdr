---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BUSINESS } from '../lib/business';

const title = `About All Dent PDR | Paintless Dent Repair — ${BUSINESS.addressLocality}, OH`;
const description = `All Dent PDR provides paintless dent repair in ${BUSINESS.regionLabel}. Expert technicians, transparent inspections, and factory-quality hail and dent repair.`;
const breadcrumbs = [
  { name: 'Home', url: 'https://alldentpdr.com' },
  { name: 'About', url: 'https://alldentpdr.com/about' },
];
---

<BaseLayout title={title} description={description} canonical="https://alldentpdr.com/about" breadcrumbs={breadcrumbs}>
  <section class="about-hero" style="background-image:url('/images/alldentafter.jpg')">
    <div class="about-hero-overlay">
      <div class="container about-hero-grid">
        <div class="about-hero-main">
          <span class="section-label">About All Dent PDR</span>
          <h1>Paintless dent repair with standards that do not move.</h1>
          <p>
            All Dent PDR serves <strong>{BUSINESS.regionLabel}</strong> with professional paintless dent repair.
            We deploy to hail-affected markets after major storms, with a current local focus on the Cincinnati metro.
          </p>
          <div class="about-hero-pills">
            <span>Inspection-first repairs</span>
            <span>Insurance direct billing</span>
            <span>Factory paint preserved</span>
          </div>
          <div class="button-row">
            <a class="button primary" href="/contact">Get a Free Estimate</a>
          </div>
        </div>

        <aside class="about-hero-panel" aria-label="Shop trust details">
          <h3>Why drivers choose us</h3>
          <ul>
            <li>{BUSINESS.regionLabel} service</li>
            <li>Panel-by-panel LED inspection process</li>
            <li>No filler-first or volume-first shortcuts</li>
            <li>Clear estimates before any repair begins</li>
          </ul>
          <div class="about-hero-meta">
            <strong>{BUSINESS.regionLabel}</strong>
            <span>Mon–Fri 8am–6pm, Sat 9am–2pm</span>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container grid-3">
      <article class="card">
        <h3>Accountable workmanship</h3>
        <p>We measure success by factory-quality results — honest inspections, transparent pricing, and work that holds up under real light.</p>
      </article>
      <article class="card">
        <h3>Restoration, not just removal</h3>
        <p>Every panel is reshaped with precision tools under specialized lighting. Your vehicle passes a final LED inspection before we call it done.</p>
      </article>
      <article class="card">
        <h3>Storm-ready teams</h3>
        <p>When hail volume spikes, we scale deployment while keeping the same quality standard on every repair.</p>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="section-label">Our coverage</span>
      <h2>Where we serve today</h2>
      <p>
        Our current local market is <strong>{BUSINESS.regionLabel}</strong> — including Cincinnati, Mason, West Chester,
        Blue Ash, Fairfield, and surrounding communities. <a href="/service-area">See all service cities</a>.
      </p>
    </div>
  </section>

  <section class="cta-banner">
    <div class="container">
      <h2>Ready for an honest inspection?</h2>
      <p>Send photos and vehicle details through our contact form — we reply the same business day.</p>
      <div class="button-row" style="justify-content: center;">
        <a class="button primary" href="/contact">Get a Free Estimate</a>
      </div>
    </div>
  </section>
</BaseLayout>
