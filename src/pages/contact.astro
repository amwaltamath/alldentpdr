---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BUSINESS } from '../lib/business';

const title = 'Contact All Dent PDR | Cleveland & Northeast Ohio';
const description = `Contact All Dent PDR for paintless dent and hail damage repair in ${BUSINESS.regionLabel}. Send an inspection request — we reply the same day.`;
const breadcrumbs = [
  { name: 'Home', url: 'https://alldentpdr.com' },
  { name: 'Contact', url: 'https://alldentpdr.com/contact' }
];
---

<BaseLayout title={title} description={description} canonical="https://alldentpdr.com/contact" breadcrumbs={breadcrumbs}>
  <section class="page-hero page-hero--contact">
    <div class="container">
      <span class="section-label">Contact Us</span>
      <h1>Request an inspection</h1>
      <p>We serve <strong>{BUSINESS.regionLabel}</strong> — including Bedford, Parma, Solon, and surrounding communities. Fill out the form or call {BUSINESS.phone} and we will reply the same day.</p>
    </div>
  </section>

  <section class="section alt">
    <div class="container contact-panel">
      <div class="form-card">
        <h3>Inspection request</h3>
        <p>Fill out the form and we'll contact you within 24 hours.</p>
        <form id="contact-form">
          <label>
            Name
            <input type="text" name="name" placeholder="Your name" required />
          </label>
          <label>
            Email
            <input type="email" name="email" placeholder="you@email.com" required />
          </label>
          <label>
            Phone
            <input type="tel" name="phone" placeholder="(555) 555-5555" />
          </label>
          <label>
            Location
            <input type="text" name="location" placeholder="City, State" />
          </label>
          <label>
            Vehicle
            <input type="text" name="vehicle" placeholder="Year, make, model" />
          </label>
          <label>
            Insurance Company
            <input type="text" name="insurance_company" placeholder="e.g. State Farm, Progressive" />
          </label>
          <label class="checkbox-label">
            <input type="checkbox" name="has_estimate" value="yes" />
            The insurance company has already written me an estimate
          </label>
          <label>
            Describe the damage
            <textarea name="message" rows="4" placeholder="Location, size, and any details" required></textarea>
          </label>
          <div class="hp-field" aria-hidden="true">
            <label>Website<input type="text" name="hp_website" tabindex="-1" autocomplete="off" /></label>
          </div>
          <input type="hidden" name="form_rendered_at" id="contact-rendered-at" />
          <button class="button primary" type="submit" id="contact-submit">Send request</button>
          <p id="contact-status" style="margin-top:12px;display:none"></p>
        </form>

        <script>
          const form = document.getElementById('contact-form');
          const btn = document.getElementById('contact-submit');
          const status = document.getElementById('contact-status');
          const renderedAtInput = document.getElementById('contact-rendered-at');
          if (renderedAtInput instanceof HTMLInputElement) renderedAtInput.value = String(Date.now());

          if ((form instanceof HTMLFormElement) && (btn instanceof HTMLButtonElement) && (status instanceof HTMLElement)) {
            form.addEventListener('submit', async (e) => {
            e.preventDefault();
            btn.disabled = true;
            btn.textContent = 'Sending…';
            status.style.display = 'none';

            const data = Object.fromEntries(new FormData(form));
            const eventId = `lead-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`;
            const getCookie = (name: string) => {
              const found = document.cookie.match(`(^|;)\\s*${name}\\s*=\\s*([^;]+)`);
              return found ? found[2] : '';
            };

            data.event_id = eventId;
            data.fbc = getCookie('_fbc');
            data.fbp = getCookie('_fbp');

            // Attach UTM attribution stored from any page visit in this session
            const utm = JSON.parse(sessionStorage.getItem('alldent_utm') || '{}');
            Object.assign(data, utm);

            try {
              const res = await fetch('/api/contact', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data),
              });

              if (res.ok) {
                form.reset();
                status.textContent = '✓ Request sent! We\'ll reply within 24 hours.';
                status.style.color = '#4a7a5c';
                const gtagFn = (globalThis as { gtag?: (...args: unknown[]) => void }).gtag;
                const fbqFn = (globalThis as { fbq?: (...args: unknown[]) => void }).fbq;
                if (typeof fbqFn === 'function') {
                  fbqFn('track', 'Lead', {}, { eventID: eventId });
                }
                if (typeof gtagFn === 'function') {
                  gtagFn('event', 'conversion', { send_to: 'AW-18153754648/o4LuCOyPm60cEJigsdBD' });
                }
              } else {
                status.textContent = 'Something went wrong. Please try again or email admin@alldentpdr.com.';
                status.style.color = '#c0392b';
                btn.disabled = false;
                btn.textContent = 'Send request';
              }
            } catch {
              status.textContent = 'Something went wrong. please try the contact form again.';
              status.style.color = '#c0392b';
              btn.disabled = false;
              btn.textContent = 'Send request';
            }

              status.style.display = 'block';
            });
          }
        </script>
      </div>
      <div class="card">
        <h3>Reach us directly</h3>
        <p><strong>Email:</strong> <a href={`mailto:${BUSINESS.email}`}>{BUSINESS.email}</a></p>
        <p class="muted" style="font-size:14px;">We reply to inspection requests by phone or email — use the form so we have your vehicle details.</p>
        <hr style="margin:16px 0;border:none;border-top:1px solid #e8e0d8;" />
        <p><strong>Service area</strong></p>
        <p>{BUSINESS.regionLabel}</p>
        <p>{BUSINESS.serviceAreaSummary}.</p>
        <hr style="margin:16px 0;border:none;border-top:1px solid #e8e0d8;" />
        <p><strong>Hours:</strong> Mon–Fri 8am–6pm · Sat 9am–2pm</p>
        <p><a href="/nationwide-hail-damage-repair">Nationwide hail storm response</a> for commercial and fleet partners.</p>
        <p>What sets us apart: premium-quality dent removal, careful finishing, and honest recommendations instead of gimmick-first sales tactics.</p>
        <div class="button-row">
          <a class="button ghost" href="/services">Review services</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
