---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Contact All Dent PDR | Hail Damage Repair Shop — Bedford &amp; Cleveland, OH';
const description = 'Contact All Dent PDR at our shop — 7695 Granger Rd, Cleveland, OH 44125. Serving Bedford, OH and all of Northeast Ohio with expert paintless dent and hail damage repair. Call 1-855-425-5336.';
const breadcrumbs = [
  { name: 'Home', url: 'https://alldentpdr.com' },
  { name: 'Contact', url: 'https://alldentpdr.com/contact' }
];
---

<BaseLayout title={title} description={description} canonical="https://alldentpdr.com/contact" breadcrumbs={breadcrumbs}>
  <section class="hero-img" style="background-image:url('/images/hail.jpg')">
    <div class="hero-img-overlay">
      <div class="container">
        <span class="section-label">Contact Us</span>
        <h1>Get a free estimate — we'll reply same day</h1>
        <p>Our repair shop is located at <strong>7695 Granger Rd, Cleveland, OH 44125</strong> — serving Bedford, OH and all of Northeast Ohio. Fill out the form, upload dent photos, or call us and we'll reply the same day.</p>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container contact-panel">
      <div class="form-card">
        <h3>Get your free estimate</h3>
        <p>Fill out the form and we'll contact you within 24 hours.</p>
        <form id="contact-form">
          <label>
            Name
            <input type="text" name="name" placeholder="Your name" required />
          </label>
          <label>
            Email
            <input type="email" name="email" placeholder="you@email.com" required />
          </label>
          <label>
            Phone
            <input type="tel" name="phone" placeholder="(555) 555-5555" />
          </label>
          <label>
            Location
            <input type="text" name="location" placeholder="City, State" />
          </label>
          <label>
            Vehicle
            <input type="text" name="vehicle" placeholder="Year, make, model" />
          </label>
          <label>
            Insurance Company
            <input type="text" name="insurance_company" placeholder="e.g. State Farm, Progressive" />
          </label>
          <label class="checkbox-label">
            <input type="checkbox" name="has_estimate" value="yes" />
            The insurance company has already written me an estimate
          </label>
          <label>
            Describe the damage
            <textarea name="message" rows="4" placeholder="Location, size, and any details" required></textarea>
          </label>
          <button class="button primary" type="submit" id="contact-submit">Get My Free Estimate</button>
          <p id="contact-status" style="margin-top:12px;display:none"></p>
        </form>

        <script>
          // Capture UTM params on every page load and persist in sessionStorage
          (function () {
            const p = new URLSearchParams(window.location.search);
            const keys = ['utm_source','utm_medium','utm_campaign','utm_content','utm_term'];
            const stored = JSON.parse(sessionStorage.getItem('alldent_utm') || '{}');
            let changed = false;
            keys.forEach((k) => { if (p.get(k)) { stored[k] = p.get(k); changed = true; } });
            if (!stored.referrer) { stored.referrer = document.referrer || ''; changed = true; }
            if (changed) sessionStorage.setItem('alldent_utm', JSON.stringify(stored));
          })();

          const form = document.getElementById('contact-form');
          const btn = document.getElementById('contact-submit');
          const status = document.getElementById('contact-status');

          form.addEventListener('submit', async (e) => {
            e.preventDefault();
            btn.disabled = true;
            btn.textContent = 'Sending…';
            status.style.display = 'none';

            const data = Object.fromEntries(new FormData(form));

            // Shared event ID for Meta pixel ↔ CAPI deduplication
            const eventId = `lead-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`;
            data.event_id = eventId;

            // Attach _fbc / _fbp cookies for better CAPI matching
            const getCookie = (n) => (document.cookie.match('(^|;)\\s*' + n + '\\s*=\\s*([^;]+)') || [])[2] || '';
            data.fbc = getCookie('_fbc');
            data.fbp = getCookie('_fbp');

            // Attach UTM attribution stored from any page visit in this session
            const utm = JSON.parse(sessionStorage.getItem('alldent_utm') || '{}');
            Object.assign(data, utm);

            try {
              const res = await fetch('/api/contact', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data),
              });

              if (res.ok) {
                form.reset();
                status.textContent = '✓ Request sent! We\'ll reply within 24 hours.';
                status.style.color = '#0a71d0';
                // Meta Pixel — Lead (eventID matches CAPI for deduplication)
                if (typeof fbq === 'function') {
                  fbq('track', 'Lead', {}, { eventID: eventId });
                }
                // Google Ads conversion — contact form submitted
                if (typeof gtag === 'function') {
                  gtag('event', 'conversion', { send_to: 'AW-18153754648/o4LuCOyPm60cEJigsdBD' });
                }
              } else {
                status.textContent = 'Something went wrong. Please call 1-855-425-5336.';
                status.style.color = '#c0392b';
                btn.disabled = false;
                btn.textContent = 'Send request';
              }
            } catch {
              status.textContent = 'Something went wrong. Please call 1-855-425-5336.';
              status.style.color = '#c0392b';
              btn.disabled = false;
              btn.textContent = 'Send request';
            }

            status.style.display = 'block';
          });
        </script>
      </div>
      <div class="card">
        <h3>Reach us directly</h3>
        <p><strong>Phone:</strong> <a href="tel:18554255336">1-855-425-5336</a></p>
        <p><strong>Email:</strong> <a href="mailto:admin@alldentpdr.com">admin@alldentpdr.com</a></p>
        <hr style="margin:16px 0;border:none;border-top:1px solid #e8e0d8;" />
        <p><strong>Shop Location</strong></p>
        <p>7695 Granger Rd<br />Cleveland, OH 44125</p>
        <p>Serving Bedford, Bedford Heights, Maple Heights, Garfield Heights, Solon, Warrensville Heights, Oakwood Village, Northfield, Twinsburg, and all of Northeast Ohio.</p>
        <hr style="margin:16px 0;border:none;border-top:1px solid #e8e0d8;" />
        <p><strong>Hours:</strong> Mon–Fri 8am–6pm · Sat 9am–2pm</p>
        <p>Serving Bedford, Cleveland, and Northeast Ohio from our Granger Rd shop.</p>
        <p>What sets us apart: premium-quality dent removal, careful finishing, and honest recommendations instead of gimmick-first sales tactics.</p>
        <div class="button-row">
          <a class="button ghost" href="/services">Review services</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <h2>Find our shop</h2>
      <p>7695 Granger Rd, Cleveland, OH 44125 — near Garfield Heights and Cuyahoga Heights, convenient to I-77 and I-480.</p>
      <div style="margin-top:24px;border-radius:12px;overflow:hidden;box-shadow:0 2px 12px rgba(0,0,0,0.1);">
        <iframe
          title="All Dent PDR shop location map"
          src="https://maps.google.com/maps?q=7695+Granger+Rd,+Cleveland,+OH+44125&output=embed"
          width="100%"
          height="400"
          style="border:0;display:block;"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </section>
</BaseLayout>


