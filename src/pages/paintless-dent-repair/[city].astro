---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { serviceAreas } from '../../data/serviceAreas';
import type { CityData } from '../../data/serviceAreas';

export const prerender = true;

export function getStaticPaths() {
  return serviceAreas.map(city => ({
    params: { city: city.slug },
    props: { city },
  }));
}

const { city } = Astro.props as { city: CityData };

const shopAddress = '7695 Granger Rd, Cleveland, OH 44125';
const shopPhone = '1-855-425-5336';
const shopEmail = 'alldentpdr@gmail.com';

const title = `Paintless Dent Repair in ${city.name}, OH | All Dent PDR`;
const description = `Paintless dent repair near ${city.name}, OH — All Dent PDR's shop is only ${city.driveMinutes} minutes away at 7695 Granger Rd, Cleveland, OH 44125. Hail damage, door dings, and minor collision dents. No repaint, factory finish preserved. Call ${shopPhone}.`;
const canonical = `https://alldentpdr.com/paintless-dent-repair/${city.slug}`;

const breadcrumbs = [
  { name: 'Home', url: 'https://alldentpdr.com' },
  { name: 'Service Area', url: 'https://alldentpdr.com/service-area' },
  { name: `${city.name} Paintless Dent Repair`, url: canonical },
];

const faqItems = [
  {
    question: `What dents can paintless dent repair fix for ${city.name} vehicles?`,
    answer: `PDR is best for dents with intact paint, including hail dents, door dings, shopping cart dents, and many minor collision dents. We assess each panel in person and provide honest guidance before any work begins. Our shop is only ${city.driveMinutes} minutes from ${city.name}.`,
  },
  {
    question: `Why choose All Dent PDR for ${city.name} vehicles?`,
    answer: `All Dent PDR is a dedicated paintless dent repair shop — not a high-volume production shop. We prioritize precision tool work, accurate panel reading, and quality-first results that protect your factory finish and resale value. ${city.name} drivers are only ${city.driveMinutes} minutes away.`,
  },
  {
    question: `Does paintless dent repair work on luxury or high-value vehicles from ${city.name}?`,
    answer: `Yes. PDR is especially valuable on higher-value vehicles because it preserves factory paint and avoids color-match issues. We serve many ${city.county} County drivers with luxury, newer-model, and collector vehicles.`,
  },
  {
    question: `How long does paintless dent repair take for ${city.name} drivers?`,
    answer: `Simple door dings are often completed in a few hours. Hail damage and multi-panel repairs typically take 1–3 days. We provide a written timeline at the time of inspection so you know exactly what to expect.`,
  },
  {
    question: `Do I need an appointment to drop off my vehicle from ${city.name}?`,
    answer: `Walk-ins are welcome at our Cleveland shop at ${shopAddress} — just ${city.driveMinutes} minutes from ${city.name}. You can also call ${shopPhone} to schedule ahead. Estimates are always free.`,
  },
];

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': ['AutoRepair', 'LocalBusiness'],
  name: `All Dent PDR — Paintless Dent Repair serving ${city.name}, OH`,
  description: `Expert paintless dent repair serving ${city.name}, OH from our shop at ${shopAddress}. Hail damage, door dings, and minor collision dents — factory finish preserved.`,
  url: canonical,
  telephone: shopPhone,
  email: shopEmail,
  image: 'https://alldentpdr.com/images/logo-branded.svg',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '7695 Granger Rd',
    addressLocality: 'Cleveland',
    addressRegion: 'OH',
    postalCode: '44125',
    addressCountry: 'US',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 41.3960,
    longitude: -81.6100,
  },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday'], opens: '08:00', closes: '18:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Saturday'], opens: '09:00', closes: '14:00' },
  ],
  areaServed: [
    city.name,
    ...city.nearbyShops,
    'Cleveland, OH',
  ],
  priceRange: '$$',
  paymentAccepted: 'Cash, Credit Card, Insurance',
  sameAs: ['https://share.google/7cCa7EhinPDCM8Owu', 'https://www.facebook.com/alldentpdr/'],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '5',
    reviewCount: '47',
    bestRating: '5',
    worstRating: '1',
  },
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  breadcrumbs={breadcrumbs}
  faqItems={faqItems}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  </Fragment>

  <!-- Hero -->
  <section class="hero">
    <div class="container hero-inner">
      <div>
        <span class="hero-pill">
          Serving {city.name}, OH · {city.distanceMiles} mi from shop · {city.driveMinutes} min drive
        </span>
        <h1>Paintless dent repair near {city.name}, Ohio</h1>
        <p>
          {city.tagline} All Dent PDR at <strong>{shopAddress}</strong> handles hail damage, door dings,
          and minor collision dents with certified paintless dent repair — no repainting, factory finish
          preserved, free written estimates before any work begins.
        </p>
        <div class="button-row">
          <a class="button primary" href="/contact">Get a Free Estimate</a>
          <a class="button ghost" href={`mailto:alldentpdr@gmail.com?subject=Dent Photos — ${city.name}&body=Please attach photos of your vehicle damage.`}>Upload Dent Photos</a>
        </div>
        <p style="margin-top:16px;font-size:0.95rem;opacity:0.85;">
          📍 {shopAddress} &nbsp;|&nbsp; Mon–Fri 8am–6pm · Sat 9am–2pm
        </p>
      </div>
      <div class="hero-card">
        <h3>Why {city.name} drivers choose All Dent PDR</h3>
        <ul>
          <li>Only {city.driveMinutes} minutes from {city.name}</li>
          <li>Certified paintless dent repair technicians</li>
          <li>Factory OEM finish preserved — no repaint</li>
          <li>Hail damage, door dings &amp; collision dents</li>
          <li>Written estimates before any work begins</li>
          <li>Walk-ins welcome · Free damage assessments</li>
        </ul>
        <p class="tag">{shopAddress}</p>
        <p>Trusted by {city.county} County drivers, dealerships, and insurance partners.</p>
      </div>
    </div>
  </section>

  <!-- Trust strip -->
  <div class="trust-strip">
    <div class="trust-item"><strong>{city.driveMinutes} min</strong><span>From {city.name}</span></div>
    <div class="trust-item"><strong>1,000+</strong><span>Vehicles Repaired</span></div>
    <div class="trust-item"><strong>5★</strong><span>Customer Rating</span></div>
    <div class="trust-item"><strong>No Repaint</strong><span>Factory Finish Kept</span></div>
  </div>

  <!-- Services covered -->
  <section class="section">
    <div class="container">
      <span class="section-label">Services Covered</span>
      <h2>One provider for your full dent repair needs in {city.name}</h2>
      <p>{city.uniqueNote}</p>
      <div class="grid-3" style="margin-top:36px;">
        <article class="card">
          <h3>Hail damage PDR</h3>
          <p>Panel-by-panel restoration for storm-damaged {city.name} vehicles when paint remains intact — insurance billing included.</p>
        </article>
        <article class="card">
          <h3>Door ding removal</h3>
          <p>Clean correction for parking lot dents and common side-panel impacts that happen every day in {city.county} County.</p>
        </article>
        <article class="card">
          <h3>Minor collision dents</h3>
          <p>PDR solutions for soft-impact damage where metal can be accurately reshaped without fillers or repainting.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Why PDR -->
  <section class="section alt">
    <div class="container">
      <span class="section-label">Why PDR</span>
      <h2>Built for quality, not gimmicks</h2>
      <p>
        Many companies market promotions first. All Dent PDR is built around finished repair quality. We focus on
        precision tool work, accurate panel reading, and final inspection standards that produce cleaner outcomes
        for {city.name} vehicles.
      </p>
      <div class="grid-3" style="margin-top:36px;">
        <article class="card">
          <h3>Precision process</h3>
          <p>Each dent is approached with controlled technique designed to minimize distortion and produce a factory-quality finish.</p>
        </article>
        <article class="card">
          <h3>Honest guidance</h3>
          <p>You get clear recommendations based on repair quality — not pressure-based upsells or unrealistic promises.</p>
        </article>
        <article class="card">
          <h3>Factory value protected</h3>
          <p>Preserving your OEM paint finish protects the trade-in and resale value of {city.name} vehicles — especially important for newer models.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Shop details -->
  <section class="section">
    <div class="container">
      <span class="section-label">Shop Info</span>
      <h2>Visit All Dent PDR — {city.driveMinutes} minutes from {city.name}</h2>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:32px;align-items:start;" class="responsive-two-col">
        <div>
          <p>
            Dropping off your vehicle from {city.name} is quick and easy. Our shop sits along Granger Rd
            in Cleveland with easy access from I-480, I-77, and Rockside Rd.
          </p>
          <p><strong>Address:</strong><br />7695 Granger Rd<br />Cleveland, OH 44125</p>
          <p><strong>Hours:</strong><br />Mon–Fri: 8:00am – 6:00pm<br />Saturday: 9:00am – 2:00pm<br />Sunday: Closed</p>
          <p>
            <strong>Phone:</strong>{' '}
            <a href={`tel:${shopPhone.replace(/-/g,'')}`} style="color:var(--rust);">{shopPhone}</a>
          </p>
          <p>
            <strong>Email:</strong>{' '}
            <a href={`mailto:${shopEmail}`} style="color:var(--rust);">{shopEmail}</a>
          </p>
          <div class="button-row" style="margin-top:20px;">
            <a class="button primary" href="/contact">Get My Quick Quote</a>
            <a class="button ghost" href="https://maps.google.com/?q=7695+Granger+Rd+Cleveland+OH+44125" target="_blank" rel="noopener">Get Directions</a>
          </div>
        </div>
        <div class="card" style="padding:0;overflow:hidden;border-radius:16px;">
          <iframe
            title={`All Dent PDR shop — paintless dent repair near ${city.name} OH`}
            src="https://maps.google.com/maps?q=7695+Granger+Rd+Cleveland+OH+44125&output=embed"
            width="100%"
            height="300"
            style="border:0;display:block;"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section alt">
    <div class="container">
      <span class="section-label">How It Works</span>
      <h2>Paintless dent repair process for {city.name} drivers</h2>
      <div class="grid-3">
        <article class="card">
          <h3>1. Drive in or call ahead</h3>
          <p>Walk-ins are welcome at our Cleveland shop — only {city.driveMinutes} minutes from {city.name}. Call {shopPhone} to reserve a time.</p>
        </article>
        <article class="card">
          <h3>2. Free inspection & estimate</h3>
          <p>We inspect every panel under specialized lighting and provide a written estimate. No charge, no pressure — just honest guidance.</p>
        </article>
        <article class="card">
          <h3>3. Expert PDR repair</h3>
          <p>Certified technicians work each dent panel by panel using precision tools — no shortcuts, no fillers, just quality results.</p>
        </article>
        <article class="card">
          <h3>4. Insurance coordination</h3>
          <p>For hail and storm damage, we bill your insurance directly and handle supplement negotiations if the estimate falls short.</p>
        </article>
        <article class="card">
          <h3>5. Final quality check</h3>
          <p>Every vehicle passes a final LED-light inspection before we call you. We don't hand back a car we wouldn't be proud of.</p>
        </article>
        <article class="card">
          <h3>6. Drive home happy</h3>
          <p>Your {city.name} vehicle is restored with factory paint fully intact — protecting finish, warranty, and resale value.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Nearby areas -->
  <section class="section">
    <div class="container">
      <span class="section-label">Also Serving</span>
      <h2>Other communities near {city.name} we serve</h2>
      <p>
        Our shop is the go-to paintless dent repair destination for all of {city.county} County and beyond.
        In addition to {city.name}, we regularly serve:
      </p>
      <div style="display:flex;flex-wrap:wrap;gap:12px;margin:24px 0;">
        {city.nearbyShops.map(n => (
          <a
            href={`/paintless-dent-repair/${n.toLowerCase().replace(/\s+/g,'-').replace(/[^a-z0-9-]/g,'')}`}
            style="padding:10px 18px;background:var(--card);border-radius:8px;border:1px solid #e8e0d8;font-weight:600;color:var(--rust);text-decoration:none;"
          >
            {n}, OH →
          </a>
        ))}
        <a
          href="/service-area"
          style="padding:10px 18px;background:var(--rust);border-radius:8px;color:#fff;font-weight:600;text-decoration:none;"
        >
          View all 20+ service areas →
        </a>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="section alt">
    <div class="container">
      <span class="section-label">Reviews</span>
      <h2>What Northeast Ohio customers say</h2>
      <div class="grid-3">
        <blockquote class="card">
          <p>"I was nervous about paintless repair but they walked me through the whole thing before starting. My car looks exactly like it did before. I'm a believer now."</p>
          <footer style="margin-top:12px;font-style:italic;font-size:0.9rem;color:var(--rust);">— Cuyahoga County vehicle owner</footer>
          <div style="color:#f5a623;font-size:1.1rem;letter-spacing:2px;margin-top:6px;">★★★★★</div>
        </blockquote>
        <blockquote class="card">
          <p>"Fast, honest, and the work holds up. I've had body shop work before that looked fine at first and then you notice things. All Dent PDR's finish work is genuinely better."</p>
          <footer style="margin-top:12px;font-style:italic;font-size:0.9rem;color:var(--rust);">— Northeast Ohio driver</footer>
          <div style="color:#f5a623;font-size:1.1rem;letter-spacing:2px;margin-top:6px;">★★★★★</div>
        </blockquote>
        <blockquote class="card">
          <p>"They fixed my hail damage and two door dings in the same visit. Factory finish on everything. I'll never take a car to a body shop again if I don't have to."</p>
          <footer style="margin-top:12px;font-style:italic;font-size:0.9rem;color:var(--rust);">— Bedford area customer</footer>
          <div style="color:#f5a623;font-size:1.1rem;letter-spacing:2px;margin-top:6px;">★★★★★</div>
        </blockquote>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container">
      <span class="section-label">FAQ</span>
      <h2>Questions about paintless dent repair near {city.name}, OH</h2>
      <div style="display:flex;flex-direction:column;gap:16px;max-width:780px;margin:0 auto;">
        {faqItems.map(item => (
          <details style="background:var(--card);border-radius:12px;padding:20px 24px;border:1px solid #e8e0d8;">
            <summary style="font-weight:600;cursor:pointer;font-size:1.05rem;">{item.question}</summary>
            <p style="margin-top:12px;color:#4a3f35;">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-banner">
    <div class="container">
      <h2>Ready for paintless dent repair? Visit us from {city.name} today.</h2>
      <p>
        All Dent PDR · {shopAddress} · Mon–Fri 8am–6pm · Sat 9am–2pm<br />
        Walk-ins welcome · Free estimates · Insurance claims handled
      </p>
      <div class="button-row" style="justify-content:center;">
        <a class="button primary" href="/contact">Get a Free Estimate</a>
        <a class="button ghost" href={`tel:${shopPhone.replace(/-/g,'')}`}>Call {shopPhone}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .responsive-two-col {
    grid-template-columns: 1fr 1fr;
  }
  @media (max-width: 720px) {
    .responsive-two-col {
      grid-template-columns: 1fr;
    }
  }
</style>
