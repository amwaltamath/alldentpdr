---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { BUSINESS } from '../../lib/business';

const title = 'PDR & Hail Repair Blog | All Dent PDR';
const description = `Expert guides on paintless dent repair, hail damage recovery, and insurance claims from All Dent PDR — serving ${BUSINESS.regionLabel}.`;
---

<BaseLayout title={title} description={description} canonical="https://alldentpdr.com/blog">
  <section class="page-hero">
    <div class="container">
      <span class="section-label">Blog</span>
      <h1>PDR &amp; hail repair guides</h1>
      <p>Practical advice on paintless dent repair, insurance claims, and storm damage from the All Dent PDR team.</p>
    </div>
  </section>

  <section class="section">
    <div class="container grid-3">
      <article class="card">
        <h3><a href="/blog/pdr-vs-body-shop">PDR vs. traditional body shop</a></h3>
        <p>When paintless repair wins — and when conventional autobody is the right call.</p>
      </article>
      <article class="card">
        <h3><a href="/blog/hail-damage-insurance-claim-guide">Hail damage insurance claim guide</a></h3>
        <p>How comprehensive coverage works and how to document storm damage.</p>
      </article>
      <article class="card">
        <h3><a href="/blog/autobody-repair-cincinnati-ohio">Autobody repair in Greater Cincinnati</a></h3>
        <p>What to expect from collision repair and PDR in Southwest Ohio.</p>
      </article>
    </div>
  </section>
</BaseLayout>
