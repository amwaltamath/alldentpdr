---
import ServiceLandingShell from '../../components/ServiceLandingShell.astro';
import { BUSINESS } from '../../lib/business';

const canonical = 'https://alldentpdr.com/services/autobody-collision-repair';
const title = `Autobody & Collision Repair ${BUSINESS.addressLocality}, OH | All Dent PDR`;
const description = `Autobody and collision repair in ${BUSINESS.regionLabel}. Paint, bumpers, panel replacement, and insurance claims — plus paintless dent repair when the factory finish can be preserved.`;
---

<ServiceLandingShell
  title={title}
  description={description}
  canonical={canonical}
  breadcrumbs={[
    { name: 'Home', url: 'https://alldentpdr.com' },
    { name: 'Services', url: 'https://alldentpdr.com/services' },
    { name: 'Autobody & Collision Repair', url: canonical },
  ]}
  faqItems={[
    {
      question: 'Do you offer full autobody repair or only paintless dent repair?',
      answer:
        'We are PDR specialists first, but we also perform conventional autobody and collision repair when paint is damaged, panels need replacement, or metal is too stretched for paintless methods. We recommend the approach that restores your vehicle correctly — not the fastest upsell.',
    },
    {
      question: 'What types of collision damage can you repair?',
      answer:
        'Common jobs include bumper cover repair or replacement, scraped quarter panels, door damage with paint break, fender repairs, blend-and-match paint work, and light structural straightening coordinated with insurance estimates. Submit photos through our contact form for an initial review.',
    },
    {
      question: 'Will you work with my insurance collision claim?',
      answer:
        'Yes. For collision and comprehensive claims we help document damage, align with adjuster estimates, and perform repairs to carrier standards. You choose your shop — Ohio law protects that right.',
    },
    {
      question: 'How is autobody repair different from PDR at your shop?',
      answer:
        'PDR reshapes metal without repainting when the OEM finish is intact. Autobody repair uses conventional methods — fillers where appropriate, refinish, parts, and clear coat — when the damage requires it. Many vehicles need a mix of both on different panels.',
    },
  ]}
  schemaName="All Dent PDR — Autobody & Collision Repair"
  schemaDescription={description}
  heroLabel={`Autobody · Collision · ${BUSINESS.addressLocality}, OH`}
  h1={`Autobody & collision repair in ${BUSINESS.addressLocality}, Ohio`}
  heroLead={`From fender benders to paint damage and bumper repairs, All Dent PDR serves ${BUSINESS.regionLabel} with honest inspections and factory-focused finish work — starting with paintless repair whenever it is the right call.`}
>
  <span class="section-label">Body shop services</span>
  <h2>Collision repair when paintless dent repair is not enough</h2>
  <p>
    Drivers searching for an <strong>auto body shop in {BUSINESS.addressLocality}</strong> or <strong>collision repair near you</strong>
    often want one team that understands both PDR and conventional body work. We assess each panel under proper lighting,
    explain whether paintless or autobody repair fits, and quote the repair before work begins.
  </p>
  <div class="grid-3" style="margin-top:28px;">
    <article class="card">
      <h3>Bumper &amp; plastic repair</h3>
      <p>Cracked bumper covers, scuffs, and impact damage — repair or replace with color-matched finish.</p>
    </article>
    <article class="card">
      <h3>Paint &amp; refinish</h3>
      <p>Scratch-through damage, chipped panels, and blend work when the factory coat cannot be preserved.</p>
    </article>
    <article class="card">
      <h3>Panel repair &amp; replacement</h3>
      <p>Doors, fenders, and quarters when metal or structure needs conventional body methods.</p>
    </article>
    <article class="card">
      <h3>PDR + autobody blend</h3>
      <p>Hail or multi-panel jobs where some areas qualify for PDR and others need paint — one plan, one shop.</p>
    </article>
    <article class="card">
      <h3>Insurance collision claims</h3>
      <p>Documentation, supplements, and communication with adjusters so your claim stays on track.</p>
    </article>
    <article class="card">
      <h3>Quality control</h3>
      <p>Final inspection for color match, panel gaps, and customer-ready delivery — the same standard we use on PDR.</p>
    </article>
  </div>

  <p style="margin-top:28px;">
    Not sure which route you need? Read our guide on
    <a href="/blog/pdr-vs-body-shop">PDR vs. traditional body shop repair</a>, then
    <a href="/contact">request an inspection</a> with photos of the damage.
  </p>
</ServiceLandingShell>
