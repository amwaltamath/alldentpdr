---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BUSINESS } from '../lib/business';

const title = `Hail Damage Repair ${BUSINESS.addressLocality}, OH | All Dent PDR`;
const description = `Hail damage repair in ${BUSINESS.regionLabel} with paintless dent repair, insurance claim help, and free estimates. Request an inspection online.`;
const canonical = 'https://alldentpdr.com/hail-damage-repair';

const breadcrumbs = [
  { name: 'Home', url: 'https://alldentpdr.com' },
  { name: 'Hail Damage Repair', url: canonical },
];

const faqItems = [
  {
    question: 'Can hail damage be fixed with PDR?',
    answer:
      'Yes, when paint is intact hail dents are often ideal for paintless dent repair. We inspect every panel and confirm the right method before work begins.',
  },
  {
    question: 'Does insurance cover hail damage repair?',
    answer:
      'In most comprehensive claims, yes. Hail damage is commonly covered after your deductible. We help document damage and work with your carrier.',
  },
  {
    question: `How much does hail damage repair cost near ${BUSINESS.addressLocality}?`,
    answer:
      'Pricing depends on dent count, panels affected, and vehicle type. We provide a free estimate after reviewing photos or an in-person inspection.',
  },
  {
    question: 'Where does All Dent PDR serve locally?',
    answer: `We are currently serving ${BUSINESS.regionLabel}. See ${BUSINESS.hailHubPath} and our service area page for city-specific details.`,
  },
];
---

<BaseLayout title={title} description={description} canonical={canonical} breadcrumbs={breadcrumbs} faqItems={faqItems}>
  <section class="hero">
    <div class="container hero-inner">
      <div>
        <span class="hero-pill">Hail damage · {BUSINESS.addressLocality}, OH</span>
        <h1>Hail damage repair in {BUSINESS.addressLocality}, Ohio</h1>
        <p>
          All Dent PDR restores storm-damaged vehicles with paintless dent repair across
          <strong>{BUSINESS.regionLabel}</strong> — no unnecessary repainting when the factory finish can be preserved.
        </p>
        <div class="button-row">
          <a class="button primary" href="/contact">Schedule a free hail estimate</a>
          <a class="button ghost" href={BUSINESS.hailHubPath}>{BUSINESS.addressLocality} hail hub</a>
        </div>
      </div>
      <div class="hero-card">
        <h3>Hail repair highlights</h3>
        <ul>
          <li>Free inspection and panel-by-panel documentation</li>
          <li>Insurance claim support from start to finish</li>
          <li>Paintless dent repair when paint is intact</li>
          <li>Written estimates before any work begins</li>
        </ul>
        <p class="tag">{BUSINESS.regionLabel}</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="section-label">Insurance claims</span>
      <h2>We help document and repair hail claims</h2>
      <p>
        After a storm, we inspect affected panels, align with your adjuster when needed, and restore your vehicle with PDR whenever it is the right method.
      </p>
      <div class="button-row" style="justify-content:center;">
        <a class="button primary" href="/contact">Request an inspection</a>
      </div>
    </div>
  </section>
</BaseLayout>
