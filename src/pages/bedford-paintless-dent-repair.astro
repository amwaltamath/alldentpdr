---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Bedford Paintless Dent Repair | Mobile PDR Service | All Dent PDR';
const description = 'Paintless dent repair in Bedford, OH and surrounding areas. Mobile PDR for hail dents, door dings, and minor collision dents with premium-quality results.';
const canonical = 'https://alldentpdr.com/bedford-paintless-dent-repair';
const breadcrumbs = [
  { name: 'Home', url: 'https://alldentpdr.com' },
  { name: 'Bedford Paintless Dent Repair', url: canonical }
];
const faqItems = [
  {
    question: 'What dents can paintless dent repair fix?',
    answer: 'PDR is best for dents with intact paint, including hail dents, door dings, and many minor collision dents. We assess each panel before repair.'
  },
  {
    question: 'Why choose All Dent PDR over high-volume repair shops?',
    answer: 'We prioritize premium craftsmanship, careful panel finishing, and detail-focused quality control instead of rushing volume.'
  },
  {
    question: 'Do you provide estimates before scheduling?',
    answer: 'Yes. We provide estimate and timeline guidance after reviewing the vehicle in person so the repair plan is accurate.'
  }
];
---

<BaseLayout title={title} description={description} canonical={canonical} breadcrumbs={breadcrumbs} faqItems={faqItems}>
  <section class="hero-img" style="background-image:url('/images/topofcarbeforandafter.jpg')">
    <div class="hero-img-overlay">
      <div class="container">
        <span class="section-label">Google Ads Landing Page</span>
        <h1>Bedford paintless dent repair for drivers who want premium results</h1>
        <p>All Dent PDR offers mobile paintless dent repair in Bedford and surrounding areas with a quality-first approach that protects your factory finish.</p>
        <div class="button-row" style="justify-content: center;">
          <a class="button primary" href="/contact">Get a Free Estimate</a>
          <a class="button ghost" href="tel:18554255336">Call 1-855-425-5336</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <span class="section-label">Services Covered</span>
      <h2>One provider for your full dent repair needs</h2>
      <div class="grid-3">
        <article class="card">
          <h3>Hail damage PDR</h3>
          <p>Panel-by-panel restoration for storm-damaged vehicles when paint remains intact.</p>
        </article>
        <article class="card">
          <h3>Door ding removal</h3>
          <p>Clean correction for parking lot dents and common side-panel impacts.</p>
        </article>
        <article class="card">
          <h3>Minor collision dents</h3>
          <p>PDR solutions for soft-impact damage where metal can be accurately reshaped.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="section-label">Why AllDent</span>
      <h2>Built for quality, not gimmicks</h2>
      <p>Many companies market promotions first. All Dent PDR is built around finished repair quality. We focus on precision tool work, accurate panel reading, and final inspection standards that produce cleaner outcomes.</p>
      <div class="grid-3">
        <article class="card">
          <h3>Precision process</h3>
          <p>Each dent is approached with controlled technique designed to minimize distortion.</p>
        </article>
        <article class="card">
          <h3>Honest guidance</h3>
          <p>You get clear recommendations based on repair quality, not pressure-based upsells.</p>
        </article>
        <article class="card">
          <h3>Trusted mobile service</h3>
          <p>Shop located at 7695 Granger Rd, south Cleveland — serving Bedford and surrounding cities with responsive scheduling.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="cta-banner">
    <div class="container">
      <h2>Ready to book Bedford-area paintless dent repair?</h2>
      <p>Tell us about the vehicle and your location for a same-day scheduling response.</p>
      <div class="button-row" style="justify-content: center;">
        <a class="button primary" href="/contact">Get My Quick Quote</a>
        <a class="button ghost" href="/services">See All Services</a>
      </div>
    </div>
  </section>
</BaseLayout>
