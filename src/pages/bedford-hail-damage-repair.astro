---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Bedford Ohio Hail Damage Repair Shop | All Dent PDR | 7695 Granger Rd Cleveland OH';
const description = 'All Dent PDR’s hail damage repair shop near Bedford, OH. Located at 7695 Granger Rd, Cleveland, OH 44125. Paintless dent repair with insurance billing. Call 1-855-425-5336.';
const canonical = 'https://alldentpdr.com/bedford-hail-damage-repair';
const breadcrumbs = [
  { name: 'Home', url: 'https://alldentpdr.com' },
  { name: 'Bedford Hail Damage Repair', url: canonical }
];
const faqItems = [
  {
    question: 'Do you serve areas around Bedford for hail repair?',
    answer: 'Yes. We currently serve Bedford, Bedford Heights, Maple Heights, Garfield Heights, Solon, Warrensville Heights, Oakwood Village, Northfield, Twinsburg, and nearby Northeast Ohio communities.'
  },
  {
    question: 'How long does hail damage repair take?',
    answer: 'Light hail repairs may be finished in one day, while moderate to severe hail damage can take 1 to 3 days depending on dent count and panel access.'
  },
  {
    question: 'Will hail repair require repainting?',
    answer: 'In many cases, no. If paint is intact, we use paintless dent repair to reshape the metal and preserve your factory finish.'
  }
];
---

<BaseLayout title={title} description={description} canonical={canonical} breadcrumbs={breadcrumbs} faqItems={faqItems}>
  <section class="hero-img" style="background-image:url('/images/hail.jpg')">
    <div class="hero-img-overlay">
      <div class="container">
        <span class="section-label">Hail Damage Repair Shop — Bedford &amp; Cleveland, OH</span>
        <h1>Bedford Ohio hail damage repair at our Cleveland shop</h1>
        <p>All Dent PDR is located at <strong>7695 Granger Rd, Cleveland, OH 44125</strong> — just minutes from Bedford, OH. We restore hail-damaged vehicles with paintless dent repair, insurance direct billing, and factory-quality results.</p>
        <div class="button-row" style="justify-content: center;">
          <a class="button primary" href="/contact">Get a Free Estimate</a>
          <a class="button ghost" href="tel:18554255336">Call 1-855-425-5336</a>
        </div>
        <p style="margin-top:12px;font-size:0.9rem;color:rgba(255,255,255,0.75);">7695 Granger Rd · Cleveland, OH 44125 · Mon–Fri 8am–6pm · Sat 9am–2pm</p>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container grid-3">
      <article class="card">
        <h3>Premium quality standard</h3>
        <p>We focus on finish quality and consistency across every panel, not rushed, volume-only output.</p>
      </article>
      <article class="card">
        <h3>Factory paint preserved</h3>
        <p>Our paintless process is designed to keep your OEM finish intact when the paint has not been broken.</p>
      </article>
      <article class="card">
        <h3>Shop-based storm repairs</h3>
        <p>Bring your vehicle to our Cleveland shop and we'll handle the full hail repair process with the right tools and a proper inspection bay.</p>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="section-label">Service Area</span>
      <h2>Serving Bedford and surrounding communities from our Cleveland shop</h2>
      <p>Our shop at <strong>7695 Granger Rd, Cleveland, OH 44125</strong> covers Bedford, Bedford Heights, Maple Heights, Garfield Heights, Solon, Warrensville Heights, Oakwood Village, Northfield, Twinsburg, and Walton Hills.</p>
      <p>If your city is nearby and impacted by the same weather event, <a href="/contact" style="color:var(--rust);">contact us</a> and we will confirm availability quickly.</p>
      <div class="button-row" style="margin-top:24px;">
        <a class="button primary" href="/hail-damage-repair-bedford-ohio">See full shop details &amp; reviews</a>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <span class="section-label">How It Works</span>
      <h2>Simple 3-step hail repair process</h2>
      <div class="grid-3">
        <article class="card">
          <h3>1. Get your free estimate</h3>
          <p>Share your city, vehicle details, and storm information so we can schedule the right evaluation.</p>
        </article>
        <article class="card">
          <h3>2. Get a clear repair plan</h3>
          <p>We provide transparent pricing and timeline guidance based on actual damage severity.</p>
        </article>
        <article class="card">
          <h3>3. Book your repair</h3>
          <p>We schedule your repair and complete the work with a quality-first process.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="cta-banner">
    <div class="container">
      <h2>Visit our Bedford-area hail damage shop</h2>
      <p>7695 Granger Rd, Cleveland, OH 44125 · Mon–Fri 8am–6pm · Sat 9am–2pm · Walk-ins welcome</p>
      <div class="button-row" style="justify-content: center;">
        <a class="button primary" href="/contact">Get My Quick Quote</a>
        <a class="button ghost" href="/services">View All Services</a>
      </div>
    </div>
  </section>
</BaseLayout>
