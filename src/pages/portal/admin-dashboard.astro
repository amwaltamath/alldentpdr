---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdminDashboardPanel from '../../components/AdminDashboard.jsx';

const title = 'Admin Dashboard | All Dent PDR';
const description = 'Admin dashboard for All Dent PDR vehicle registration and work-status management.';
const canonical = 'https://alldentpdr.com/portal/admin-dashboard';
