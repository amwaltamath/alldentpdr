---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VendorPortal from '../../components/VendorPortal.jsx';

const title = 'Vendor Portal | All Dent PDR';
const description = 'Vendor portal for shops receiving referred paintless dent repair leads from All Dent PDR.';
const canonical = 'https://alldentpdr.com/portal/vendor';
---

<BaseLayout title={title} description={description} canonical={canonical} noindex={true} bare={true}>
  <VendorPortal client:load />
</BaseLayout>
