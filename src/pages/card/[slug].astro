---
export const prerender = true;

export function getStaticPaths() {
  return [
    {
      params: { slug: 'zachary' },
      props: { name: 'Zachary', lastName: '', title: 'PDR Specialist', email: 'zachary@alldentpdr.com' }
    },
    {
      params: { slug: 'kevin' },
      props: { name: 'Kevin', lastName: '', title: 'PDR Specialist', email: 'kevin@alldentpdr.com' }
    },
    {
      params: { slug: 'patrick' },
      props: { name: 'Patrick', lastName: '', title: 'PDR Specialist', email: 'patrick@alldentpdr.com' }
    },
  ];
}

const { name, lastName, title, email } = Astro.props;
const { slug } = Astro.params;

const phone = '1-855-425-5336';
const phoneRaw = '+18554255336';
const website = 'https://alldentpdr.com';
const displayName = lastName ? `${name} ${lastName}` : name;

const qrData = encodeURIComponent(website);
const qrUrl = `https://api.qrserver.com/v1/create-qr-code/?size=240x240&data=${qrData}&color=b0522b&bgcolor=ffffff&margin=10`;

const vcardLines = [
  'BEGIN:VCARD',
  'VERSION:3.0',
  `FN:${displayName}`,
  `N:${lastName};${name};;;`,
  'ORG:All Dent PDR',
  `TITLE:${title}`,
  `TEL;TYPE=WORK,VOICE:${phoneRaw}`,
  `EMAIL;TYPE=WORK:${email}`,
  `URL:${website}`,
  'ADR;TYPE=WORK:;;Bedford;OH;;United States',
  'END:VCARD'
].join('\n');

const vcardHref = `data:text/vcard;charset=utf-8,${encodeURIComponent(vcardLines)}`;
const pageTitle = `${displayName} — All Dent PDR`;
const canonical = `${website}/card/${slug}`;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={`Digital business card for ${displayName}, ${title} at All Dent PDR. Mobile paintless dent repair.`} />
  <meta name="robots" content="noindex,nofollow" />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

  <!-- Open Graph for shareable preview -->
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={`${title} · All Dent PDR · ${phone}`} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content="profile" />
  <meta property="og:image" content={`${website}/images/logo.jpg`} />

  <style>
    *, *::before, *::after { box-sizing: border-box; }

    body {
      margin: 0;
      min-height: 100dvh;
      background: #f0ede8;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px 16px;
      -webkit-font-smoothing: antialiased;
    }

    .biz-card {
      width: 100%;
      max-width: 400px;
      background: #fff;
      border-radius: 24px;
      overflow: hidden;
      box-shadow: 0 20px 60px rgba(27,18,12,.18), 0 4px 16px rgba(27,18,12,.08);
    }

    /* Header gradient */
    .biz-header {
      background: linear-gradient(145deg, #b0522b 0%, #8c3e1e 60%, #6d2f14 100%);
      padding: 32px 28px 28px;
      position: relative;
      overflow: hidden;
    }
    .biz-header::before {
      content: '';
      position: absolute;
      top: -40px; right: -40px;
      width: 180px; height: 180px;
      border-radius: 50%;
      background: rgba(255,255,255,.06);
    }
    .biz-header::after {
      content: '';
      position: absolute;
      bottom: -60px; left: -20px;
      width: 220px; height: 220px;
      border-radius: 50%;
      background: rgba(255,255,255,.04);
    }

    .biz-logo-row {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 20px;
      position: relative; z-index: 1;
    }
    .biz-logo-row img {
      width: 44px; height: 44px;
      border-radius: 10px;
      display: block;
    }
    .biz-company {
      color: rgba(255,255,255,.9);
      font-size: 13px;
      font-weight: 600;
      letter-spacing: .04em;
      text-transform: uppercase;
    }

    .biz-name {
      color: #fff;
      font-family: "Georgia", "Times New Roman", serif;
      font-size: clamp(1.6rem, 6vw, 2rem);
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.1;
      margin: 0 0 6px;
      position: relative; z-index: 1;
    }
    .biz-title {
      color: rgba(255,255,255,.75);
      font-size: 14px;
      font-weight: 500;
      letter-spacing: .06em;
      text-transform: uppercase;
      margin: 0;
      position: relative; z-index: 1;
    }

    /* Body */
    .biz-body {
      padding: 24px 28px;
    }

    /* Contact buttons */
    .biz-contacts {
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin-bottom: 22px;
    }
    .biz-contact-btn {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 14px 16px;
      background: #faf6f1;
      border: 1px solid #e8ddd4;
      border-radius: 12px;
      text-decoration: none;
      color: #1a1410;
      transition: background .2s, border-color .2s, transform .15s;
    }
    .biz-contact-btn:hover {
      background: #f3ece3;
      border-color: #c8a88a;
      transform: translateY(-1px);
    }
    .biz-contact-icon {
      width: 38px; height: 38px;
      border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      font-size: 18px;
      flex-shrink: 0;
    }
    .biz-contact-icon.phone { background: #edf7f0; }
    .biz-contact-icon.email { background: #eef2fb; }
    .biz-contact-icon.web   { background: #fdf3ed; }
    .biz-contact-label {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: #8a7060;
      display: block;
      margin-bottom: 2px;
    }
    .biz-contact-value {
      font-size: 14.5px;
      font-weight: 600;
      color: #1a1410;
    }

    /* QR section */
    .biz-qr-section {
      display: flex;
      align-items: center;
      gap: 18px;
      background: #faf6f1;
      border: 1px solid #e8ddd4;
      border-radius: 14px;
      padding: 16px;
      margin-bottom: 18px;
    }
    .biz-qr-section img {
      width: 88px; height: 88px;
      border-radius: 8px;
      border: 1px solid #e0d6cc;
      display: block;
      flex-shrink: 0;
    }
    .biz-qr-text strong {
      display: block;
      font-size: 13.5px;
      font-weight: 700;
      color: #1a1410;
      margin-bottom: 4px;
    }
    .biz-qr-text p {
      font-size: 12.5px;
      color: #8a7060;
      margin: 0;
      line-height: 1.4;
    }

    /* Save contact CTA */
    .biz-save-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: 100%;
      padding: 15px;
      background: linear-gradient(135deg, #b0522b, #8c3e1e);
      color: #fff;
      font-size: 15px;
      font-weight: 700;
      border-radius: 12px;
      text-decoration: none;
      letter-spacing: .02em;
      transition: opacity .2s, transform .15s;
      box-shadow: 0 4px 14px rgba(176,82,43,.35);
    }
    .biz-save-btn:hover { opacity: .92; transform: translateY(-1px); }

    .biz-footer {
      padding: 16px 28px 20px;
      text-align: center;
      border-top: 1px solid #f0ece6;
    }
    .biz-footer a {
      font-size: 12.5px;
      color: #b0522b;
      text-decoration: none;
      font-weight: 600;
    }
    .biz-footer a:hover { text-decoration: underline; }
  </style>
</head>
<body>
  <div class="biz-card">
    <div class="biz-header">
      <div class="biz-logo-row">
        <img src="/images/logo.jpg" alt="All Dent PDR logo" />
        <span class="biz-company">All Dent PDR</span>
      </div>
      <p class="biz-name">{displayName}</p>
      <p class="biz-title">{title}</p>
    </div>

    <div class="biz-body">
      <div class="biz-contacts">
        <a href={`tel:${phoneRaw}`} class="biz-contact-btn">
          <span class="biz-contact-icon phone">📞</span>
          <span>
            <span class="biz-contact-label">Phone</span>
            <span class="biz-contact-value">{phone}</span>
          </span>
        </a>

        <a href={`mailto:${email}`} class="biz-contact-btn">
          <span class="biz-contact-icon email">✉️</span>
          <span>
            <span class="biz-contact-label">Email</span>
            <span class="biz-contact-value">{email}</span>
          </span>
        </a>

        <a href={website} target="_blank" rel="noreferrer" class="biz-contact-btn">
          <span class="biz-contact-icon web">🌐</span>
          <span>
            <span class="biz-contact-label">Website</span>
            <span class="biz-contact-value">alldentpdr.com</span>
          </span>
        </a>
      </div>

      <div class="biz-qr-section">
        <img
          src={qrUrl}
          alt="QR code linking to alldentpdr.com"
          width="88"
          height="88"
          loading="lazy"
        />
        <div class="biz-qr-text">
          <strong>Scan to visit our site</strong>
          <p>Point your camera at the code to open alldentpdr.com instantly.</p>
        </div>
      </div>

      <a href={vcardHref} download={`${slug}-alldentpdr.vcf`} class="biz-save-btn">
        <span>＋</span> Save to Contacts
      </a>
    </div>

    <div class="biz-footer">
      <a href={website}>← Back to alldentpdr.com</a>
    </div>
  </div>
</body>
</html>
