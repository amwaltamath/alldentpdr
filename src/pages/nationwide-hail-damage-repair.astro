---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BUSINESS, buildLocalBusinessSchema, LEAD_CTA } from '../lib/business';

const canonical = 'https://alldentpdr.com/nationwide-hail-damage-repair';
const title = 'Nationwide Hail Damage Repair & Storm Response | All Dent PDR';
const description = `All Dent PDR deploys for major hail events nationwide. Day-to-day local paintless dent repair is currently in ${BUSINESS.regionLabel}; storm teams rotate to the next market after regional hail.`;
const breadcrumbs = [
  { name: 'Home', url: 'https://alldentpdr.com' },
  { name: 'Nationwide Hail Response', url: canonical },
];
const faqItems = [
  {
    question: 'Where is All Dent PDR based right now?',
    answer: `${BUSINESS.deploymentBlurb} For local PDR near you today, see ${BUSINESS.pdrHubPath}.`,
  },
  {
    question: 'Who should contact you for nationwide hail response?',
    answer: 'Dealership groups, fleet operators, insurance partners, and property managers coordinating post-storm vehicle repair can use our contact form with fleet details and storm location.',
  },
  {
    question: 'Do you rotate to new cities after storms?',
    answer:
      'Yes. When hail volume warrants it, we redeploy local service to the affected market. Our website and service area pages follow the current deployment city.',
  },
];
const schema = buildLocalBusinessSchema({
  name: 'All Dent PDR — Nationwide Hail Damage Response',
  description,
  url: canonical,
  areaServed: [{ '@type': 'Country', name: 'United States' }],
});
---

<BaseLayout title={title} description={description} canonical={canonical} breadcrumbs={breadcrumbs} faqItems={faqItems}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>

  <section class="page-hero page-hero--services">
    <div class="container">
      <span class="section-label">Storm response · Rotating local markets</span>
      <h1>Nationwide hail damage repair &amp; storm response</h1>
      <p>
        All Dent PDR runs a <strong>storm-season deployment model</strong>: local paintless dent repair where the team is
        stationed today (<strong>{BUSINESS.regionLabel}</strong>), plus nationwide capacity when hail volume demands it.
      </p>
      <div class="button-row" style="justify-content:center;margin-top:16px;">
        <a class="button primary" href={LEAD_CTA.href}>Contact for storm deployment</a>
        <a class="button ghost" href={BUSINESS.pdrHubPath}>Current local market</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Local market today — Cincinnati</h2>
      <p>
        Cincinnati-area customers should use our <a href={BUSINESS.pdrHubPath}>Cincinnati PDR hub</a> and
        <a href={BUSINESS.hailHubPath}>Cincinnati hail repair page</a> or <a href="/service-area">service area</a> for city pages.
      </p>
      <p>
        This page is for commercial storm-response inquiries and scheduling the <em>next</em> deployment market.
      </p>
    </div>
  </section>
</BaseLayout>
