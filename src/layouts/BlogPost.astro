---
import BaseLayout from './BaseLayout.astro';

const { title, description, pubDate, heroImage, heroImageAlt } = Astro.props;
const fullTitle = `${title} | AllDent PDR`;
const canonical = `https://alldentpdr.com${Astro.url.pathname}`;
const ogImage = heroImage || '/images/logo.jpg';
const breadcrumbs = [
  { name: 'Home', url: 'https://alldentpdr.com' },
  { name: 'Blog', url: 'https://alldentpdr.com/blog' },
  { name: title, url: canonical }
];
---

<BaseLayout
  title={fullTitle}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  type="article"
  publishedDate={pubDate}
  breadcrumbs={breadcrumbs}
>
  {heroImage && (
    <figure class="blog-hero">
      <img src={heroImage} alt={heroImageAlt || title} width="1600" height="640" />
    </figure>
  )}

  <section class="section blog-section">
    <article class="blog-article" itemscope itemtype="https://schema.org/BlogPosting">
      <meta itemprop="headline" content={title} />
      <meta itemprop="description" content={description} />
      <meta itemprop="datePublished" content={pubDate} />
      <meta itemprop="author" content="AllDent PDR" />
      {heroImage && <meta itemprop="image" content={`https://alldentpdr.com${heroImage}`} />}

      <header class="blog-header">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            <li><a href="/blog">Blog</a></li>
            <li aria-current="page">{title}</li>
          </ol>
        </nav>
        <p class="tag">{pubDate}</p>
        <h1>{title}</h1>
        <p class="blog-lead">{description}</p>
      </header>

      <div class="blog-content">
        <slot />
      </div>

      <footer class="blog-footer">
        <div class="button-row">
          <a class="button primary" href="/contact">Get a Free Estimate</a>
          <a class="button ghost" href="/services">View All Services</a>
        </div>
      </footer>
    </article>
  </section>
</BaseLayout>
