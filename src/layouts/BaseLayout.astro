---
import '../styles/global.css';
import MobileMenu from '../components/MobileMenu.jsx';
import ChatWidget from '../components/ChatWidget.jsx';

const {
  title = 'AllDent PDR | Paintless Dent Repair Cleveland & Bedford, OH',
  description = 'Expert paintless dent repair and hail damage repair shop at 7695 Granger Rd, Cleveland, OH — serving Bedford and all of Northeast Ohio. Mobile service also available nationwide for storm damage. Fast, affordable PDR for door dings, hail damage, and minor collision dents.',
  canonical = 'https://alldentpdr.com',
  ogImage = '/images/logo-branded.svg',
  noindex = false,
  type = 'website',
  publishedDate = '',
  bare = false,
  breadcrumbs = [] as { name: string; url: string }[],
  faqItems = [] as { question: string; answer: string }[]
} = Astro.props;

const gaId: string = 'G-T7RLXD05RW';
const adsId: string = 'AW-18153754648';
const adsLeadSendTo: string = `${adsId}/o4LuCOyPm60cEJigsdBD`;
const metaPixelId: string = import.meta.env.PUBLIC_META_PIXEL_ID || '1284377713827510';
const pathname = Astro.url?.pathname || '/';
const isPortalRoute = pathname.startsWith('/portal/');
const isRegisterRoute = pathname === '/register';
const shouldShowLeadPopup = !bare && !isPortalRoute && !isRegisterRoute;
const useLiquidDarkTheme = !isPortalRoute;
const themeColor = useLiquidDarkTheme ? '#080d14' : '#b0522b';
const navLinks = [
  { href: '/services', label: 'Services' },
  { href: '/service-area', label: 'Service Area' },
  { href: '/about', label: 'About' },
  { href: '/blog', label: 'Blog' },
  { href: '/register', label: 'Vehicle Registration' },
  { href: '/portal/customer-login', label: 'Customer Login' },
];

const isActiveLink = (href: string) => pathname === href || pathname.startsWith(`${href}/`);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`https://alldentpdr.com${ogImage}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`https://alldentpdr.com${ogImage}`} />
    <meta name="twitter:image:alt" content="AllDent PDR - Paintless Dent Repair" />
    <meta name="google-site-verification" content="UdUBGJ6CT7WTj7DlCdAeVQ0JqiMupWXbQ9hrj3ZiUwY" />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta name="geo.region" content="US-OH" />
    <meta name="geo.placename" content="Cleveland" />
    <meta name="geo.position" content="41.3960;-81.6100" />
    <meta name="ICBM" content="41.3960, -81.6100" />
    {type === 'article' && publishedDate && (
      <meta property="article:published_time" content={publishedDate} />
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/images/logo.jpg" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content={themeColor} />

    <!-- Preconnect to third-party origins used below, to shave connection setup time off render-blocking-adjacent requests -->
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="preconnect" href="https://connect.facebook.net" />

    <!-- Google Analytics + Google Ads -->
    {gaId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline set:html={`window.dataLayer = window.dataLayer || []; function gtag(){dataLayer.push(arguments);} gtag('js', new Date()); gtag('config', '${gaId}'); gtag('config', '${adsId}');`}></script>
      </>
    )}

    <!-- Meta Pixel -->
    {metaPixelId && (
      <>
        <script is:inline set:html={`!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod? n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window, document,'script','https://connect.facebook.net/en_US/fbevents.js'); fbq('init', '${metaPixelId}'); fbq('track', 'PageView');`}></script>
      </>
    )}

    <!-- Structured Data for Local SEO -->
    <script type="application/ld+json">
      {`
        {
          "@context": "https://schema.org",
          "@type": "AutoRepair",
          "name": "AllDent PDR",
          "description": "Expert paintless dent repair and hail damage repair shop serving Bedford, OH, Cleveland, and all of Northeast Ohio. Mobile service also available nationwide.",
          "url": "https://alldentpdr.com",
          "telephone": "1-855-425-5336",
          "email": "alldentpdr@gmail.com",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "7695 Granger Rd",
            "addressLocality": "Cleveland",
            "addressRegion": "OH",
            "postalCode": "44125",
            "addressCountry": "US"
          },
          "areaServed": [
            { "@type": "City", "name": "Bedford" },
            { "@type": "City", "name": "Cleveland" },
            { "@type": "City", "name": "Bedford Heights" },
            { "@type": "City", "name": "Maple Heights" },
            { "@type": "City", "name": "Garfield Heights" },
            { "@type": "City", "name": "Solon" },
            { "@type": "City", "name": "Warrensville Heights" },
            { "@type": "Country", "name": "United States" }
          ],
          "geo": {
            "@type": "GeoCoordinates",
            "latitude": 41.3960,
            "longitude": -81.6100
          },
          "hasOfferCatalog": {
            "@type": "OfferCatalog",
            "name": "Paintless Dent Repair Services",
            "itemListElement": [
              {
                "@type": "OfferCatalog",
                "name": "Door Ding Repair",
                "description": "Quick PDR fixes for small dents and creases without fillers or repaint"
              },
              {
                "@type": "OfferCatalog",
                "name": "Hail Damage Repair",
                "description": "Panel-by-panel hail dent restoration that preserves your OEM finish"
              },
              {
                "@type": "OfferCatalog",
                "name": "Minor Collision Dent Repair",
                "description": "Correct dents from low-speed impacts when paint is undamaged"
              }
            ]
          },
          "paymentAccepted": "Cash, Credit Card, Debit Card",
          "priceRange": "$$",
          "openingHours": "Mo-Fr 08:00-18:00, Sa 09:00-14:00",
          "image": "https://alldentpdr.com/images/logo-branded.svg",
          "sameAs": ["https://www.facebook.com/alldentpdr/"],
          "aggregateRating": {
            "@type": "AggregateRating",
            "ratingValue": "5",
            "reviewCount": "47",
            "bestRating": "5",
            "worstRating": "1"
          }
        }
      `}
    </script>

    {/* Breadcrumb Schema */}
    {breadcrumbs.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": breadcrumbs.map((crumb: { name: string; url: string }, i: number) => ({
          "@type": "ListItem",
          "position": i + 1,
          "name": crumb.name,
          "item": crumb.url
        }))
      })} />
    )}

    {/* FAQ Schema */}
    {faqItems.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map((item: { question: string; answer: string }) => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      })} />
    )}
    <slot name="head" />
  </head>
  <body class:list={{ 'theme-liquid-dark': useLiquidDarkTheme }}>
    {!isPortalRoute && (
      <script is:inline>
        (function () {
          try {
            var saved = localStorage.getItem('alldent-theme');
            if (saved === 'light') document.body.classList.remove('theme-liquid-dark');
            else if (saved === 'dark') document.body.classList.add('theme-liquid-dark');
          } catch (e) {}
          var metaTheme = document.querySelector('meta[name="theme-color"]');
          if (metaTheme) {
            metaTheme.setAttribute('content', document.body.classList.contains('theme-liquid-dark') ? '#080d14' : '#b0522b');
          }
        })();
      </script>
    )}
    <script is:inline>
      (function () {
        const p = new URLSearchParams(window.location.search);
        const stored = JSON.parse(sessionStorage.getItem('alldent_utm') || '{}');
        let changed = false;
        ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'].forEach((key) => {
          if (p.get(key)) { stored[key] = p.get(key); changed = true; }
        });
        if (p.get('gclid')) {
          stored.gclid = p.get('gclid');
          if (!stored.utm_source) { stored.utm_source = 'google'; stored.utm_medium = stored.utm_medium || 'cpc'; }
          changed = true;
        }
        if (p.get('fbclid')) {
          stored.fbclid = p.get('fbclid');
          if (!stored.utm_source) { stored.utm_source = 'facebook'; stored.utm_medium = stored.utm_medium || 'paid'; }
          changed = true;
        }
        if (!stored.referrer && document.referrer) { stored.referrer = document.referrer; changed = true; }
        if (changed) sessionStorage.setItem('alldent_utm', JSON.stringify(stored));
      })();
    </script>
    {!bare && (
      <header class="site-header">
        <div class="container header-inner">
          <a class="logo" href="/">
            <img src="/images/logo.jpg" alt="AllDent PDR - Paintless Dent Repair Cleveland & Bedford, OH" class="logo-img" />
            <div class="logo-text">
              <span class="logo-mark">AllDent PDR</span>
              <span class="logo-sub">Bedford, OH Shop &amp; Mobile</span>
            </div>
          </a>
          <nav class="nav">
            {navLinks.map((link) => (
              <a
                href={link.href}
                class:list={{ 'is-active': isActiveLink(link.href) }}
                aria-current={isActiveLink(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            ))}
            <a class="nav-cta" href="/contact">Request Inspection</a>
          </nav>
          {!isPortalRoute && (
            <button
              type="button"
              id="theme-toggle-btn"
              class="theme-toggle"
              role="switch"
              aria-checked={useLiquidDarkTheme ? 'true' : 'false'}
              aria-label="Toggle dark mode"
              title="Toggle light / dark mode"
            >
              <span class="theme-toggle-icon theme-toggle-icon--sun" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
              </span>
              <span class="theme-toggle-icon theme-toggle-icon--moon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
              </span>
              <span class="theme-toggle-thumb" aria-hidden="true"></span>
            </button>
          )}
          <MobileMenu client:load pathname={pathname} />
        </div>
      </header>
    )}
    {!isPortalRoute && (
      <script is:inline>
        (function () {
          var btn = document.getElementById('theme-toggle-btn');
          if (!btn) return;
          var metaTheme = document.querySelector('meta[name="theme-color"]');
          function isDark() { return document.body.classList.contains('theme-liquid-dark'); }
          function sync() {
            btn.setAttribute('aria-checked', isDark() ? 'true' : 'false');
            if (metaTheme) metaTheme.setAttribute('content', isDark() ? '#080d14' : '#b0522b');
          }
          sync();
          btn.addEventListener('click', function () {
            document.body.classList.toggle('theme-liquid-dark');
            var dark = isDark();
            try { localStorage.setItem('alldent-theme', dark ? 'dark' : 'light'); } catch (e) {}
            sync();
          });
        })();
      </script>
    )}

    <main>
      <slot />
    </main>

    {!bare && (
      <footer class="site-footer">
        <div class="container footer-inner">
          <div>
            <div class="logo" style="margin-bottom: 14px;">
              <img src="/images/logo.jpg" alt="AllDent PDR" class="logo-img" />
              <div class="logo-text">
                <span class="logo-mark" style="color:#fff;">AllDent PDR</span>
                <span class="logo-sub">Bedford, OH Shop &amp; Mobile</span>
              </div>
            </div>
            <p>Paintless dent repair shop at 7695 Granger Rd, Cleveland, OH 44125 — serving Bedford, OH and all of Northeast Ohio. Mobile service also available nationwide for hail damage, door dings, and minor collision dents.</p>
          </div>
          <div>
            <h5>Services</h5>
            <p><a href="/services">Paintless Dent Repair</a></p>
            <p><a href="/services">Hail Damage Repair</a></p>
            <p><a href="/services">Door Ding Removal</a></p>
            <p><a href="/hail-damage-repair-bedford-ohio">Bedford OH Hail Repair Shop</a></p>
            <p><a href="/service-area">All Service Areas</a></p>
            <p><a href="/blog">PDR Blog</a></p>
            <p><a href="/testimonials">Customer Reviews</a></p>
          </div>
          <div>
            <h5>Nearby Cities</h5>
            <p><a href="/hail-damage-repair/garfield-heights">Garfield Heights</a></p>
            <p><a href="/hail-damage-repair/maple-heights">Maple Heights</a></p>
            <p><a href="/hail-damage-repair/parma">Parma</a></p>
            <p><a href="/hail-damage-repair/independence">Independence</a></p>
            <p><a href="/hail-damage-repair/solon">Solon</a></p>
            <p><a href="/hail-damage-repair/warrensville-heights">Warrensville Heights</a></p>
          </div>
          <div>
            <h5>Contact</h5>
            <p><a href="tel:18554255336">1-855-425-5336</a></p>
            <p><a href="mailto:admin@alldentpdr.com">admin@alldentpdr.com</a></p>
            <p><a href="https://www.facebook.com/alldentpdr/" target="_blank" rel="noopener noreferrer">Facebook</a></p>
            <p><a href="/contact">Request Inspection</a></p>
            <p><a href="/portal/customer-login">Customer Login</a></p>
            <p><a href="/portal/admin-dashboard">Admin</a></p>
          </div>
          <div>
            <h5>Shop Location</h5>
            <p>7695 Granger Rd</p>
            <p>Cleveland, OH 44125</p>
            <p>(Serving Bedford &amp; NE Ohio)</p>
          </div>
          <div>
            <h5>Hours</h5>
            <p>Mon – Fri · 8am – 6pm</p>
            <p>Sat · 9am – 2pm</p>
            <p>Shop &amp; Mobile Nationwide</p>
          </div>
        </div>
        <div class="container footer-bottom">
          <span>© 2026 AllDent PDR · Hail Damage Repair Shop — Bedford &amp; Cleveland, OH</span>
          <span><a href="/about">About</a> · <a href="/service-area">Service Area</a> · <a href="/blog">Blog</a> · <a href="/contact">Contact</a></span>
        </div>
      </footer>
    )}

    {!bare && (
      <div class="mobile-cta-bar" aria-label="Quick contact">
        <a class="mcta-call" href="tel:18554255336">Call Now</a>
        <a class="mcta-quote" href="/contact">Get Free Estimate</a>
      </div>
    )}

    {shouldShowLeadPopup && (
      <div id="lead-popup-backdrop" class="lead-popup-backdrop" hidden>
        <section class="lead-popup" role="dialog" aria-modal="true" aria-labelledby="lead-popup-title">
          <button id="lead-popup-close" class="lead-popup-close" type="button" aria-label="Close popup">&times;</button>
          <img class="lead-popup-logo" src="/images/logo.jpg" alt="All Dent PDR" loading="lazy" decoding="async" />
          <p class="lead-popup-kicker">Free Estimate</p>
          <h3 id="lead-popup-title">Get your quick estimate</h3>
          <p class="lead-popup-copy">Tell us about your vehicle and damage. We will contact you shortly.</p>
          <p class="lead-popup-call">
            <a href="tel:18554255336" class="lead-popup-call-link">Prefer to talk? Call 1-855-425-5336</a>
          </p>

          <form id="lead-popup-form" class="lead-popup-form">
            <label for="lead-popup-name">Full name</label>
            <input id="lead-popup-name" name="name" type="text" required placeholder="Jane Smith" />

            <label for="lead-popup-phone">Phone</label>
            <input id="lead-popup-phone" name="phone" type="tel" required placeholder="(555) 555-5555" />

            <label for="lead-popup-email">Email</label>
            <input id="lead-popup-email" name="email" type="email" required placeholder="you@email.com" />

            <label for="lead-popup-details">Vehicle and damage details</label>
            <input id="lead-popup-details" name="message" type="text" required placeholder="2019 Toyota Camry, hail dents on hood and roof" />

            <div class="hp-field" aria-hidden="true">
              <label>Website<input type="text" name="hp_website" tabindex="-1" autocomplete="off" /></label>
            </div>

            <button class="button primary" type="submit">Get Free Estimate</button>
            <button id="lead-popup-later" class="lead-popup-link" type="button">Maybe later</button>
            <p id="lead-popup-status" class="lead-popup-status" aria-live="polite"></p>
          </form>
        </section>
      </div>
    )}

    {shouldShowLeadPopup && (
      <script is:inline define:vars={{ pageTitle: title, pagePath: pathname, adsLeadSendTo }}>
        (() => {
          const KEY = 'alldent_lead_popup_last_closed_at';
          const getAttribution = () => JSON.parse(sessionStorage.getItem('alldent_utm') || '{}');
          const isPaidTraffic = () => {
            const utm = getAttribution();
            const src = String(utm.utm_source || '').toLowerCase();
            const med = String(utm.utm_medium || '').toLowerCase();
            return Boolean(
              utm.gclid ||
              utm.fbclid ||
              /google|facebook|meta|fb|instagram|ig/.test(src) ||
              /cpc|paid|ppc/.test(med)
            );
          };
          const paid = isPaidTraffic();
          const COOLDOWN_MS = paid ? 1000 * 60 * 60 * 4 : 1000 * 60 * 60 * 24;
          const OPEN_DELAY_MS = paid ? 1200 : 3500;
          const backdrop = document.getElementById('lead-popup-backdrop');
          const closeBtn = document.getElementById('lead-popup-close');
          const laterBtn = document.getElementById('lead-popup-later');
          const form = document.getElementById('lead-popup-form');
          const status = document.getElementById('lead-popup-status');
          if (!(backdrop instanceof HTMLElement) || !(form instanceof HTMLFormElement)) return;
          const formRenderedAt = Date.now();

          const wasRecentlyClosed = () => {
            const raw = localStorage.getItem(KEY);
            if (!raw) return false;
            const ts = Number(raw);
            return Number.isFinite(ts) && (Date.now() - ts) < COOLDOWN_MS;
          };

          const openPopup = () => {
            backdrop.hidden = false;
            document.body.classList.add('popup-open');
          };

          const closePopup = () => {
            backdrop.hidden = true;
            document.body.classList.remove('popup-open');
            localStorage.setItem(KEY, String(Date.now()));
          };

          if (!wasRecentlyClosed()) {
            window.setTimeout(openPopup, OPEN_DELAY_MS);
          }

          closeBtn?.addEventListener('click', closePopup);
          laterBtn?.addEventListener('click', closePopup);

          form.addEventListener('submit', async (event) => {
            event.preventDefault();
            const data = new FormData(form);
            const message = String(data.get('message') || '').trim();
            const eventId = `lead-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`;
            const utm = getAttribution();
            const getCookie = (name) => {
              const found = document.cookie.match(`(^|;)\\s*${name}\\s*=\\s*([^;]+)`);
              return found ? found[2] : '';
            };
            const payload = {
              name: String(data.get('name') || '').trim(),
              email: String(data.get('email') || '').trim(),
              phone: String(data.get('phone') || '').trim(),
              location: 'Website popup lead',
              vehicle: pageTitle,
              message,
              utm_source: utm.utm_source || '',
              utm_medium: utm.utm_medium || '',
              utm_campaign: utm.utm_campaign || '',
              utm_content: utm.utm_content || '',
              utm_term: utm.utm_term || '',
              referrer: utm.referrer || document.referrer || '',
              event_id: eventId,
              fbc: getCookie('_fbc'),
              fbp: getCookie('_fbp'),
              hp_website: String(data.get('hp_website') || ''),
              form_rendered_at: formRenderedAt,
            };

            status.textContent = 'Sending...';
            status.className = 'lead-popup-status';

            try {
              const res = await fetch('/api/contact', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
              });
              if (!res.ok) throw new Error('Failed to submit');

              status.textContent = 'Thanks. Your free estimate request was sent.';
              status.className = 'lead-popup-status is-success';
              form.reset();
              localStorage.setItem(KEY, String(Date.now()));

              if (typeof window.fbq === 'function') {
                window.fbq('track', 'Lead', {}, { eventID: eventId });
              }
              if (typeof window.gtag === 'function') {
                window.gtag('event', 'conversion', {
                  send_to: adsLeadSendTo,
                  event_callback: () => {}
                });
              }

            } catch {
              status.textContent = 'Could not send right now. Please try again.';
              status.className = 'lead-popup-status is-error';
            }
          });
        })();
      </script>
    )}

    {!bare && (
      <script is:inline>
        document.addEventListener('click', (event) => {
          const link = event.target instanceof Element ? event.target.closest('a[href^="tel:"]') : null;
          if (!(link instanceof HTMLAnchorElement)) return;
          if (typeof window.fbq === 'function') window.fbq('track', 'Contact');
          if (typeof window.gtag === 'function') {
            window.gtag('event', 'generate_lead', { method: 'phone_click' });
          }
        });
      </script>
    )}

    {!bare && <ChatWidget client:idle />}
  </body>
</html>
