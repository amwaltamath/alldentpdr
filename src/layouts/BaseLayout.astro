---
import '../styles/global.css';
import MobileMenu from '../components/MobileMenu.jsx';

const {
  title = 'All Dent PDR | Paintless Dent Repair Cincinnati',
  description = 'Mobile paintless dent repair based in Cincinnati. We travel nationwide to repair hail storm damage on-site. Fast, affordable PDR for door dings, hail damage, and minor collision dents.',
  canonical = 'https://alldentpdr.com',
  ogImage = '/images/logo-branded.svg',
  noindex = false,
  type = 'website',
  publishedDate = '',
  bare = false,
  breadcrumbs = [] as { name: string; url: string }[],
  faqItems = [] as { question: string; answer: string }[]
} = Astro.props;

const gaId: string = 'G-T7RLXD05RW';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`https://alldentpdr.com${ogImage}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`https://alldentpdr.com${ogImage}`} />
    <meta name="twitter:image:alt" content="All Dent PDR - Paintless Dent Repair" />
    <meta name="google-site-verification" content="UdUBGJ6CT7WTj7DlCdAeVQ0JqiMupWXbQ9hrj3ZiUwY" />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta name="geo.region" content="US-OH" />
    <meta name="geo.placename" content="Cleveland" />
    <meta name="geo.position" content="41.3960;-81.6100" />
    <meta name="ICBM" content="41.3960, -81.6100" />
    {type === 'article' && publishedDate && (
      <meta property="article:published_time" content={publishedDate} />
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/images/logo.jpg" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#b0522b" />
    
    <!-- Google Analytics -->
    {gaId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline set:html={`window.dataLayer = window.dataLayer || []; function gtag(){dataLayer.push(arguments);} gtag('js', new Date()); gtag('config', '${gaId}');`}></script>
      </>
    )}

    <!-- Structured Data for Local SEO -->
    <script type="application/ld+json">
      {`
        {
          "@context": "https://schema.org",
          "@type": "AutoRepair",
          "name": "All Dent PDR",
          "description": "Expert paintless dent repair and hail damage repair shop serving Bedford, OH, Cleveland, and all of Northeast Ohio. Mobile service also available nationwide.",
          "url": "https://alldentpdr.com",
          "telephone": "1-855-425-5336",
          "email": "alldentpdr@gmail.com",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "7695 Granger Rd",
            "addressLocality": "Cleveland",
            "addressRegion": "OH",
            "postalCode": "44125",
            "addressCountry": "US"
          },
          "areaServed": [
            { "@type": "City", "name": "Bedford" },
            { "@type": "City", "name": "Cleveland" },
            { "@type": "City", "name": "Bedford Heights" },
            { "@type": "City", "name": "Maple Heights" },
            { "@type": "City", "name": "Garfield Heights" },
            { "@type": "City", "name": "Solon" },
            { "@type": "City", "name": "Warrensville Heights" },
            { "@type": "Country", "name": "United States" }
          ],
          "geo": {
            "@type": "GeoCoordinates",
            "latitude": 41.3960,
            "longitude": -81.6100
          },
          "hasOfferCatalog": {
            "@type": "OfferCatalog",
            "name": "Paintless Dent Repair Services",
            "itemListElement": [
              {
                "@type": "OfferCatalog",
                "name": "Door Ding Repair",
                "description": "Quick PDR fixes for small dents and creases without fillers or repaint"
              },
              {
                "@type": "OfferCatalog",
                "name": "Hail Damage Repair",
                "description": "Panel-by-panel hail dent restoration that preserves your OEM finish"
              },
              {
                "@type": "OfferCatalog",
                "name": "Minor Collision Dent Repair",
                "description": "Correct dents from low-speed impacts when paint is undamaged"
              }
            ]
          },
          "paymentAccepted": "Cash, Credit Card, Debit Card",
          "priceRange": "$$",
          "openingHours": "Mo-Fr 08:00-18:00, Sa 09:00-14:00",
          "image": "https://alldentpdr.com/images/logo-branded.svg",
          "sameAs": ["https://www.facebook.com/alldentpdr/"],
          "aggregateRating": {
            "@type": "AggregateRating",
            "ratingValue": "5",
            "reviewCount": "47",
            "bestRating": "5",
            "worstRating": "1"
          }
        }
      `}
    </script>

    {/* Breadcrumb Schema */}
    {breadcrumbs.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": breadcrumbs.map((crumb: { name: string; url: string }, i: number) => ({
          "@type": "ListItem",
          "position": i + 1,
          "name": crumb.name,
          "item": crumb.url
        }))
      })} />
    )}

    {/* FAQ Schema */}
    {faqItems.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map((item: { question: string; answer: string }) => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      })} />
    )}
    <slot name="head" />
    <!-- Google Analytics 4 + Google Ads -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-T7RLXD05RW"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-T7RLXD05RW');
      gtag('config', 'AW-18153754648');
    </script>
  </head>
  <body>
    {!bare && (
      <header class="site-header">
        <div class="container header-inner">
          <a class="logo" href="/">
            <img src="/images/logo.jpg" alt="All Dent PDR - Paintless Dent Repair Cincinnati" class="logo-img" />
            <div class="logo-text">
              <span class="logo-mark">All Dent PDR</span>
              <span class="logo-sub">Bedford, OH Shop &amp; Mobile</span>
            </div>
          </a>
          <nav class="nav">
            <a href="/services">Services</a>
            <a href="/service-area">Service Area</a>
            <a href="/about">About</a>
            <a href="/blog">Blog</a>
            <a href="/register">Vehicle Registration</a>
            <a href="/portal/customer-login">Customer Login</a>
            <a class="nav-cta" href="/contact">Request Inspection</a>
          </nav>
          <MobileMenu client:load />
        </div>
      </header>
    )}

    <main>
      <slot />
    </main>

    {!bare && (
      <footer class="site-footer">
        <div class="container footer-inner">
          <div>
            <div class="logo" style="margin-bottom: 14px;">
              <img src="/images/logo.jpg" alt="All Dent PDR" class="logo-img" />
              <div class="logo-text">
                <span class="logo-mark" style="color:#fff;">All Dent PDR</span>
                <span class="logo-sub">Bedford, OH Shop &amp; Mobile</span>
              </div>
            </div>
            <p>Paintless dent repair shop at 7695 Granger Rd, Cleveland, OH 44125 — serving Bedford, OH and all of Northeast Ohio. Mobile service also available nationwide for hail damage, door dings, and minor collision dents.</p>
          </div>
          <div>
            <h5>Services</h5>
            <p><a href="/services">Paintless Dent Repair</a></p>
            <p><a href="/services">Hail Damage Repair</a></p>
            <p><a href="/services">Door Ding Removal</a></p>
            <p><a href="/hail-damage-repair-bedford-ohio">Bedford OH Hail Repair Shop</a></p>
            <p><a href="/service-area">All Service Areas</a></p>
            <p><a href="/blog">PDR Blog</a></p>
          </div>
          <div>
            <h5>Nearby Cities</h5>
            <p><a href="/hail-damage-repair/garfield-heights">Garfield Heights</a></p>
            <p><a href="/hail-damage-repair/maple-heights">Maple Heights</a></p>
            <p><a href="/hail-damage-repair/parma">Parma</a></p>
            <p><a href="/hail-damage-repair/independence">Independence</a></p>
            <p><a href="/hail-damage-repair/solon">Solon</a></p>
            <p><a href="/hail-damage-repair/warrensville-heights">Warrensville Heights</a></p>
          </div>
          <div>
            <h5>Contact</h5>
            <p><a href="tel:18554255336">1-855-425-5336</a></p>
            <p><a href="mailto:admin@alldentpdr.com">admin@alldentpdr.com</a></p>
            <p><a href="https://www.facebook.com/alldentpdr/" target="_blank" rel="noopener noreferrer">Facebook</a></p>
            <p><a href="/contact">Request Inspection</a></p>
            <p><a href="/portal/customer-login">Customer Login</a></p>
            <p><a href="/portal/admin-dashboard">Admin</a></p>
          </div>
          <div>
            <h5>Shop Location</h5>
            <p>7695 Granger Rd</p>
            <p>Cleveland, OH 44125</p>
            <p>(Serving Bedford &amp; NE Ohio)</p>
          </div>
          <div>
            <h5>Hours</h5>
            <p>Mon – Fri · 8am – 6pm</p>
            <p>Sat · 9am – 2pm</p>
            <p>Shop &amp; Mobile Nationwide</p>
          </div>
        </div>
        <div class="container footer-bottom">
          <span>© 2026 All Dent PDR · Hail Damage Repair Shop — Bedford &amp; Cleveland, OH</span>
          <span><a href="/about">About</a> · <a href="/service-area">Service Area</a> · <a href="/blog">Blog</a> · <a href="/contact">Contact</a></span>
        </div>
      </footer>
    )}
  </body>
</html>
